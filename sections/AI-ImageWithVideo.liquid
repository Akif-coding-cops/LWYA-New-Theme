{% schema %}
{
  "name": "Text + video right",
  "tag": "section",
  "class": "holiday-split",
  "settings": [
    {
      "type": "video",
      "id": "right_video",
      "label": "Right video (upload)"
    },
    {
      "type": "video_url",
      "id": "right_video_url",
      "label": "Right video (YouTube/Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image (fallback if no video)"
    },
    {
      "type": "range",
      "id": "right_image_position_x",
      "label": "Image horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "0% = left, 50% = center, 100% = right"
    },
    {
      "type": "range",
      "id": "right_image_position_y",
      "label": "Image vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "0% = top, 50% = center, 100% = bottom"
    },
    {
      "type": "range",
      "id": "right_image_scale",
      "label": "Image scale",
      "min": 100,
      "max": 150,
      "step": 1,
      "unit": "%",
      "default": 100,
      "info": "Zoom in/out the image"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Left background color",
      "default": "#1B3E20"
    },
    {
      "type": "image_picker",
      "id": "left_bg_image",
      "label": "Left background image"
    },
    {
      "type": "select",
      "id": "left_bg_size",
      "label": "Left background size",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [
        {
          "type": "text",
          "id": "content",
          "label": "Title text",
          "default": "Your VIP Holiday Offer Ends Soon!"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 12
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>This exclusive Vivacity holiday offer is only available for a limited time — once it’s gone, it’s gone for the season. Don’t wait to give (or get) the scent of joy.</p>"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 18
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown",
      "settings": [
        {
          "type": "text",
          "id": "target_datetime",
          "label": "Target datetime (YYYY-MM-DD HH:MM)",
          "info": "Example: 2025-12-31 23:59"
        },
        {
          "type": "color",
          "id": "time_color",
          "label": "Time color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 6
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 20
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Get My Set Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "btn_bg",
          "label": "Button background",
          "default": "#E3C92B"
        },
        {
          "type": "color",
          "id": "btn_color",
          "label": "Button text",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Text + video right",
      "blocks": [
        { "type": "title" },
        { "type": "text" },
        { "type": "countdown" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}

<section
  class="tw-w-full"
  style="padding-top: {{ section.settings.padding_y }}px; padding-bottom: {{ section.settings.padding_y }}px;"
>
  <div class="tw-max-w-[1440px] tw-mx-auto tw-flex tw-flex-col lg:tw-flex-row xl:tw-max-h-[800px] lg:tw-px-0">
    <div
      class="tw-flex-1 tw-flex tw-items-center"
      style="
        background-color: {{ section.settings.left_bg_color }};
        {% if section.settings.left_bg_image != blank %}
          background-image: url({{ section.settings.left_bg_image | image_url: width: 1000 }});
          background-size: {{ section.settings.left_bg_size }};
          background-position: center;
        {% endif %}
      "
    >
      <div class="tw-w-full tw-px-[24px] lg:tw-px-[60px] xxl:tw-px-0 tw-py-responsive-[40,0] tw-text-center">
        {% for block in section.blocks %}
          {% assign mt = block.settings.margin_top | append: 'px' %}
          {% assign mb = block.settings.margin_bottom | append: 'px' %}
          {% case block.type %}
            {% when 'title' %}
              <h2
                class="tw-text-responsive-[24,36] tw-font-[700] tw-text-ruttan"
                style="margin-top: {{ mt }}; margin-bottom: {{ mb }}; color: {{ block.settings.color }};"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.content }}
              </h2>
            {% when 'text' %}
              <div
                class="tw-body-text-[16,20]"
                style="margin-top: {{ mt }}; margin-bottom: {{ mb }}; color: {{ block.settings.color }};"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.content }}
              </div>
            {% when 'countdown' %}
              <div
                class="split-countdown tw-text-ruttan"
                style="margin-top: {{ mt }}; margin-bottom: {{ mb }}; color: {{ block.settings.time_color }};"
                data-countdown-target="{{ block.settings.target_datetime | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="tw-flex tw-gap-responsive-[10,14] tw-items-center tw-flex-wrap tw-justify-center">
                  <div class="tw-flex tw-flex-col tw-items-center">
                    <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none days">00</div>
                    <div class="tw-text-responsive-[9,10] tw-uppercase tw-tracking-[0.14em] tw-mt-[4px]">DAYS</div>
                  </div>
                  <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none tw-mb-[20px]">:</div>
                  <div class="tw-flex tw-flex-col tw-items-center">
                    <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none hours">00</div>
                    <div class="tw-text-responsive-[9,10] tw-uppercase tw-tracking-[0.14em] tw-mt-[4px]">HRS</div>
                  </div>
                  <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none tw-mb-[20px]">:</div>
                  <div class="tw-flex tw-flex-col tw-items-center">
                    <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none minutes">00</div>
                    <div class="tw-text-responsive-[9,10] tw-uppercase tw-tracking-[0.14em] tw-mt-[4px]">MIN</div>
                  </div>
                  <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none tw-mb-[20px]">:</div>
                  <div class="tw-flex tw-flex-col tw-items-center">
                    <div class="tw-text-responsive-[28,45] tw-font-[700] tw-leading-none seconds">00</div>
                    <div class="tw-text-responsive-[9,10] tw-uppercase tw-tracking-[0.14em] tw-mt-[4px]">SEC</div>
                  </div>
                </div>
              </div>
            {% when 'button' %}
              {% if block.settings.label != blank %}
                <div style="margin-top: {{ mt }}; margin-bottom: {{ mb }};">
                  <a
                    {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
                    class="tw-inline-block tw-button-size-[10,12,20,26] tw-text-responsive-[18,24] tw-font-[600]"
                    style="background: {{ block.settings.btn_bg }}; color: {{ block.settings.btn_color }};"
                  >
                    {{ block.settings.label }}
                  </a>
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <div class="tw-w-full lg:tw-w-[742px] lg:tw-mt-0">
      {% if section.settings.right_video != blank %}
        {{
          section.settings.right_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            class: 'tw-w-full tw-h-full tw-object-cover',
            playsinline: true
        }}
      {% elsif section.settings.right_video_url != blank %}
        <div class="tw-relative tw-w-full tw-pt-[56.25%]">
          {{
            section.settings.right_video_url
            | video_tag:
              class: 'tw-absolute tw-top-0 tw-left-0 tw-w-full tw-h-full',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false
          }}
        </div>
      {% elsif section.settings.right_image != blank %}
        <div class="tw-w-full tw-h-full tw-overflow-hidden">
          <img
            src="{{ section.settings.right_image | image_url: width: 1500 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            class="tw-w-full tw-h-full tw-object-cover"
            loading="lazy"
            width="1500"
            height="1200"
            style="object-position: {{ section.settings.right_image_position_x }}% {{ section.settings.right_image_position_y }}%; transform: scale({{ section.settings.right_image_scale | divided_by: 100.0 }});"
          >
        </div>
      {% endif %}
    </div>
  </div>

  <script>
    (function() {
      var root = document.currentScript && document.currentScript.closest
        ? document.currentScript.closest('section')
        : null;
      if (!root) return;
      var timers = root.querySelectorAll('.split-countdown');
      timers.forEach(function(timer) {
        var target = timer.getAttribute('data-countdown-target');
        if (!target) return;
        var targetTime = new Date(target.replace(/-/g, '/')).getTime();
        if (isNaN(targetTime)) return;
        function tick() {
          var now = Date.now();
          var diff = targetTime - now;
          if (diff < 0) diff = 0;
          var days = Math.floor(diff / (1000 * 60 * 60 * 24));
          var hrs = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          var secs = Math.floor((diff % (1000 * 60)) / 1000);
          var dEl = timer.querySelector('.days');
          var hEl = timer.querySelector('.hours');
          var mEl = timer.querySelector('.minutes');
          var sEl = timer.querySelector('.seconds');
          if (!dEl || !hEl || !mEl || !sEl) return;
          dEl.textContent = String(days).padStart(2, '0');
          hEl.textContent = String(hrs).padStart(2, '0');
          mEl.textContent = String(mins).padStart(2, '0');
          sEl.textContent = String(secs).padStart(2, '0');
        }
        tick();
        setInterval(tick, 1000);
      });
    })();
  </script>
</section>
