<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: 1rem;
    position: relative;
    z-index: 4;
    background-color: {{ section.settings.section_bg_color }};
  }

  /* Header height and max-width */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header.container {
      min-height: 143px;
      max-width: 1400px;
      margin-left: auto;
      margin-right: auto;
      border-radius: 0 !important;
      transition: min-height 0.3s ease;
    }
  }

  /* Scroll behavior - shrink header */
  .is-scrolling #shopify-section-{{ section.id }} .header.container {
    min-height: 90px;
  }

  /* Background image positioning */
  #shopify-section-{{ section.id }} .header.container {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .header-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    object-position: {{ section.settings.bg_position_x_mobile }}% {{ section.settings.bg_position_y_mobile }}%;
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header-background-image {
      object-position: {{ section.settings.bg_position_x }}% {{ section.settings.bg_position_y }}%;
    }
  }

  /* Ensure content is above background */
  #shopify-section-{{ section.id }} .header__primary-nav,
  #shopify-section-{{ section.id }} .header__logo,
  #shopify-section-{{ section.id }} .header__secondary-nav {
    position: relative;
    z-index: 1;
  }

  /* Desktop menu on left */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header.container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .header__primary-nav {
      justify-self: start;
    }

    #shopify-section-{{ section.id }} .header__logo {
      grid-column: 2;
      justify-self: center;
    }

    #shopify-section-{{ section.id }} .header__secondary-nav {
      justify-self: end;
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .header__primary-nav ul {
      display: flex;
      gap: 1.5rem; 
      list-style: none;
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .header__primary-nav-item a {
      text-decoration: none;
      font-weight: 500;
      transition: opacity 0.2s;
    }

    #shopify-section-{{ section.id }} .header__primary-nav-item a:hover {
      opacity: 0.7;
    }
  }

  /* Custom cart icon styling */
  #shopify-section-{{ section.id }} .header__secondary-nav img[alt="Cart"] {
    width: 27px !important;
    height: 27px !important;
    filter: contrast(1.3);
  }

  /* Custom Search Modal - Professional & Clean */
  #shopify-section-{{ section.id }} .custom-search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #shopify-section-{{ section.id }} .custom-search-modal.is-open {
    display: block;
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  #shopify-section-{{ section.id }} .custom-search-modal__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background: white;
    padding: 2rem 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transform: translateY(-100%);
    transition: transform 0.3s ease;
  }
  #shopify-section-{{ section.id }} .custom-search-modal.is-open .custom-search-modal__content {
    transform: translateY(0);
  }
  #shopify-section-{{ section.id }} .custom-search-modal__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__form {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 2px solid #e5e5e5;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #666;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.25rem;
    padding: 0.5rem 0;
    background: transparent;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__input::-webkit-search-cancel-button,
  #shopify-section-{{ section.id }} .custom-search-modal__input::-webkit-search-decoration,
  #shopify-section-{{ section.id }} .custom-search-modal__input::-webkit-search-results-button,
  #shopify-section-{{ section.id }} .custom-search-modal__input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    display: none;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__input::placeholder {
    color: #999;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    transition: color 0.2s;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__close:hover {
    color: #000;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__close-icon {
    width: 24px;
    height: 24px;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__results {
    margin-top: 1rem;
    min-height: auto;
    max-height: 60vh;
    overflow-y: auto;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__results .predictive-search__results {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 0.5rem 1rem;
  }
  #shopify-section-{{ section.id }} .custom-search-modal__results .predictive-search__products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1.5rem;
  }
  /* Limit to max 6 products */
  #shopify-section-{{ section.id }} .custom-search-modal__results .predictive-search__products > *:nth-child(n+7) {
    display: none;
  }
  /* Limit suggestions/collections to max 6 */
  #shopify-section-{{ section.id }} .custom-search-modal__results .predictive-search__suggestions > *:nth-child(n+7) {
    display: none;
  }
  /* Limit each category to max 6 items */
  #shopify-section-{{ section.id }} .custom-search-modal__results .predictive-search__category > *:nth-child(n+7) {
    display: none;
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}
</style>

<script>
  // Scroll detection with hysteresis to prevent flickering
  (function () {
    let isScrolled = false;
    const scrollDownThreshold = 100;
    const scrollUpThreshold = 50;

    window.addEventListener('scroll', function () {
      const scrollPosition = window.scrollY;

      if (!isScrolled && scrollPosition > scrollDownThreshold) {
        isScrolled = true;
        document.documentElement.classList.add('is-scrolling');
      } else if (isScrolled && scrollPosition < scrollUpThreshold) {
        isScrolled = false;
        document.documentElement.classList.remove('is-scrolling');
      }
    });
  })();

  // Custom Search Modal - Simple & Professional
  (function () {
    const sectionId = '{{ section.id }}';
    const searchModalId = `custom-search-modal-${sectionId}`;
    const searchTriggerId = `search-trigger-${sectionId}`;

    function initSearchModal() {
      const searchTrigger = document.getElementById(searchTriggerId);
      const searchModal = document.getElementById(searchModalId);
      const searchInput = searchModal?.querySelector('.custom-search-modal__input');
      const searchForm = searchModal?.querySelector('.custom-search-modal__form');
      const closeButton = searchModal?.querySelector('.custom-search-modal__close');
      const overlay = searchModal?.querySelector('.custom-search-modal__overlay');
      const predictiveSearch = searchModal?.querySelector('predictive-search');

      console.log('🔍 Search Modal Debug:', {
        searchModalId,
        hasSearchModal: !!searchModal,
        hasSearchForm: !!searchForm,
        formId: searchForm?.id,
        hasPredictiveSearch: !!predictiveSearch,
      });

      if (!searchTrigger || !searchModal) return;

      // Open modal
      searchTrigger.addEventListener('click', function (e) {
        e.preventDefault();
        searchModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          if (searchInput) searchInput.focus();
        }, 100);
      });

      // Close modal
      function closeModal() {
        searchModal.classList.remove('is-open');
        document.body.style.overflow = '';
      }
      if (closeButton) {
        closeButton.addEventListener('click', closeModal);
      }
      if (overlay) {
        overlay.addEventListener('click', closeModal);
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && searchModal.classList.contains('is-open')) {
          closeModal();
        }
      });

      // Allow form submission on Enter key
      if (searchForm) {
        searchForm.addEventListener('submit', function (e) {
          console.log('📝 Form submit event triggered');
          console.log('Form action:', this.action);
          console.log('Search query:', searchInput?.value);
          // Don't prevent default - let form submit naturally
        });
      }

      // Listen for "View all results" button clicks
      if (predictiveSearch) {
        predictiveSearch.addEventListener('click', function (e) {
          const viewAllButton = e.target.closest('button[form]');
          if (viewAllButton) {
            console.log('🔘 View all results button clicked');
            console.log('Button form attribute:', viewAllButton.getAttribute('form'));
            console.log('Target form ID:', searchForm?.id);

            // Manually trigger form submission if form attribute doesn't match
            if (searchForm && viewAllButton.getAttribute('form') !== searchForm.id) {
              console.log('⚠️ Form ID mismatch - manually submitting form');
              e.preventDefault();
              searchForm.submit();
            }
          }
        });
      }

      // Observe predictive search results and limit to 6 items
      if (predictiveSearch) {
        const searchObserver = new MutationObserver(function (mutations) {
          // Limit products to 6
          const products = predictiveSearch.querySelectorAll('.predictive-search__products > *');
          products.forEach((item, index) => {
            item.style.display = index >= 6 ? 'none' : '';
          });

          // Limit suggestions to 6
          const suggestions = predictiveSearch.querySelectorAll('.predictive-search__suggestions > *');
          suggestions.forEach((item, index) => {
            item.style.display = index >= 6 ? 'none' : '';
          });

          // Limit collections to 6
          const collections = predictiveSearch.querySelectorAll('.predictive-search__collections > *');
          collections.forEach((item, index) => {
            item.style.display = index >= 6 ? 'none' : '';
          });

          // Update "View all results" button form attribute
          const viewAllButton = predictiveSearch.querySelector('button[form]');
          if (viewAllButton && searchForm) {
            console.log('🔧 Updating View all button form attribute to:', searchForm.id);
            viewAllButton.setAttribute('form', searchForm.id);
          }
        });

        // Observe both the main element and slot content
        searchObserver.observe(predictiveSearch, { childList: true, subtree: true });

        const slotContent = predictiveSearch.querySelector('[slot="results"]');
        if (slotContent) {
          searchObserver.observe(slotContent, { childList: true, subtree: true });
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearchModal);
    } else {
      initSearchModal();
    }
  })();
</script>

<height-observer variable="header">
  <x-header
    {% if section.settings.hide_on_scroll and section.settings.enable_sticky %}
      hide-on-scroll
    {% endif %}
    class="header container color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  >
    {%- if section.settings.background_image != blank -%}
      <img
        src="{{ section.settings.background_image | image_url: width: 1440 }}"
        alt="Header background"
        class="header-background-image"
        width="1440"
        height="300"
        loading="eager"
      >
    {%- endif -%}

    {%- comment -%}PRIMARY NAVIGATION{%- endcomment -%}
    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu | default: menu -%}

    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      <nav class="header__primary-nav" aria-label="{{ 'header.general.primary_navigation' | t | escape }}">
        <button type="button" aria-controls="sidebar-menu" class="lg:hidden">
          <span class="sr-only">{{ 'header.general.open_menu' | t }}</span>
          {%- render 'icon' with 'hamburger', class: 'header__nav-icon' -%}
        </button>

        {% comment %} {%- if menu.links.size > 0 -%}
          <ul class="contents unstyled-list md-max:hidden lg:flex">
            {%- for link in menu.links -%}
              <li class="header__primary-nav-item">
                <a
                  href="{{ link.url }}"
                  class="block h6"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%} {% endcomment %}


        {%- if menu.links.size > 0 -%}
  <ul class="contents unstyled-list md-max:hidden lg:flex">
    {%- for link in menu.links -%}
      {%- assign has_dropdown = false -%}
      {%- if link.links.size > 0 -%}{%- assign has_dropdown = true -%}{%- endif -%}

      <li class="header__primary-nav-item {% if has_dropdown %}has-submenu{% endif %}">
        <a
          href="{{ link.url }}"
          class="block h6 flex items-center gap-1"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{ link.title }}
          {% if has_dropdown %}
            <span class="icon-chevron-down"></span> {% endif %}
        </a>

        {%- if has_dropdown -%}
          <ul class="dropdown-menu shadow-md border absolute bg-white p-4 hidden navbar-links-li" style="left:120px; ">
            {%- for childlink in link.links -%}
              <li class="dropdown-item py-1">
                <a href="{{ childlink.url }}" class="text-sm hover:text-red-500">
                  {{ childlink.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}




      </nav>
    {%- endif -%}

    {%- comment -%}LOGO{%- endcomment -%}
    {%- capture logo_content -%}
      {%- if section.settings.logo -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}
        <span class="sr-only">{{ shop.name }}</span>
        {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image' -}}
      {%- else -%}
        <span class="header__logo-text h5">{{ shop.name }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
    {% endif %}

    {%- comment -%}SECONDARY NAV{%- endcomment -%}
    <nav class="header__secondary-nav">
      {%- if section.settings.show_account_icon and shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="header__action-item-link tap-area"
          {% if request.page_type == 'customers/account'
            or request.page_type == 'customers/order'
            or request.page_type == 'customers/addresses'
          %}
            aria-current="page"
          {% endif %}
        >
          <span class="sr-only">{{ 'header.general.account' | t }}</span>
          {%- render 'icon' with 'account', class: 'header__nav-icon' -%}
        </a>
      {%- endif -%}

      {%- if section.settings.show_search_icon -%}
        <button
          type="button"
          id="search-trigger-{{ section.id }}"
          class="header__action-item-link tap-area"
          style="background: none; border: none; cursor: pointer; padding: 0;"
        >
          <span class="sr-only">{{ 'header.general.open_search' | t }}</span>
          {%- render 'icon' with 'search', class: 'header__nav-icon' -%}
        </button>
      {%- endif -%}

      {%- if section.settings.show_cart_icon -%}
        <a
          href="{{ routes.cart_url }}"
          class="header__action-item-link tap-area"
          {% if settings.cart_type == 'drawer' and request.page_type != 'cart' %}
            is="custom-button" aria-controls="cart-drawer" aria-expanded="false"
          {% endif %}
          aria-label="{{ 'header.general.cart' | t | escape }}"
        >
          <img src="{{ 'cartnew.png' | asset_url }}" alt="Cart" width="27" height="27" style="display: block;">
        </a>
      {%- endif -%}
    </nav>

    {%- if section.settings.show_search_icon -%}
      {%- comment -%}Custom Search Modal{%- endcomment -%}
      <div id="custom-search-modal-{{ section.id }}" class="custom-search-modal">
        <div class="custom-search-modal__overlay"></div>
        <div class="custom-search-modal__content">
          <div class="custom-search-modal__container">
            <form
              id="custom-search-form-{{ section.id }}"
              action="{{ routes.search_url }}"
              method="get"
              role="search"
              class="custom-search-modal__form"
              aria-owns="custom-predictive-search-{{ section.id }}"
            >
              <svg
                class="custom-search-modal__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
              <input
                type="search"
                name="q"
                class="custom-search-modal__input"
                placeholder="Search for products..."
                autocomplete="off"
                spellcheck="false"
              >
              <button type="button" class="custom-search-modal__close" aria-label="Close search">
                <svg
                  class="custom-search-modal__close-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </form>
            <div class="custom-search-modal__results">
              <predictive-search id="custom-predictive-search-{{ section.id }}" class="predictive-search">
                <div class="predictive-search__content" slot="results"></div>
              </predictive-search>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}MOBILE SIDEBAR{%- endcomment -%}
    {%- if sidebar_menu.links.size > 0 -%}
      {%- render 'header-sidebar',
        menu: sidebar_menu,
        color_scheme: section.settings.sidebar_color_scheme,
        show_dividers: section.settings.sidebar_show_dividers
      -%}
    {%- endif -%}
  </x-header>
</height-observer>

{% schema %}
{
  "name": "AI New Header With Menu",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional background image for the header"
    },
    {
      "type": "range",
      "id": "bg_position_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position X (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "bg_position_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position Y (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "bg_position_x_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position X (mobile)",
      "default": 50
    },
    {
      "type": "range",
      "id": "bg_position_y_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position Y (mobile)",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional: Upload a custom logo"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_mobile_max_width",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 100
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Hide on scroll down",
      "info": "Only works with sticky header enabled",
      "default": false
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Desktop menu (left side)",
      "info": "Menu will appear on left side on desktop",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "sidebar_menu",
      "label": "Mobile menu (drawer)",
      "info": "Leave empty to use desktop menu"
    },
    {
      "type": "color_scheme",
      "id": "sidebar_color_scheme",
      "label": "Mobile sidebar color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "sidebar_show_dividers",
      "label": "Show dividers in mobile menu",
      "default": true
    },
    {
