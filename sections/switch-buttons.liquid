<style>
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
.button-section {
  display: flex;
  justify-content: center;
  align-items: center;
  background:#1C1D52;
}

.button-wrapper {
  display: flex;
  /* border-radius: 5px; */
  overflow: hidden;
}

.button {
  display: block;
  padding: 10px 20px;
  text-decoration: none;
  color: white;
  background-color: transparent;
  transition: background-color 0.3s ease;
  border: 1px solid transparent;
}
a.btn__color {
  color: #FBFFFF;
  font-size: 18px;
  text-transform: uppercase;
  display: flex;
  padding: 6px 32px;
  justify-content: center;
  align-items: center;
  gap: 10px;
  transition: color 0.3s ease, background 0.3s ease;
}

a.btn__color.active {
  color: #1C1D52 !important;
  background: #FF6FAB;
}

    @media screen and (max-width:760px){
   .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
    }
</style>

<section class="container section-{{ section.id }}-padding">
  <div class="button-section bdradius">
  <div class="button-wrapper">
<a href="{{ routes.root_url }}" class="btn__color btn__active1 globalClassInria_Sans {% if request.path == '/' %}active{% endif %}">
  {{ section.settings.button_1_text }}
</a>
    <a href="{{ section.settings.button_2_url }}" class="btn__color btn__active2 globalClassInria_Sans {% if request.path == '/collections/jewelry' %}active{% endif %}">
      {{ section.settings.button_2_text }}
    </a>
  </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const buttons = document.querySelectorAll('.btn__color');

  // Add click event listeners to buttons
  buttons.forEach((button) => {
    button.addEventListener('click', function() {
      // Remove the active class from all buttons
      buttons.forEach(btn => btn.classList.remove('active'));

      // Add the active class to the clicked button
      this.classList.add('active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Switch buttons",
  "settings": [
   {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_bottom",
      "default": 36
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 Text",
      "default": "BEAUTY"
    },
    {
      "type": "url",
      "id": "button_1_url",
      "label": "Button 1 URL",
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 Text",
      "default": "BLING"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Button 2 URL",
    }
  ],
  "presets": [
    {
      "name": "Switch buttons",
    }
  ]
}
{% endschema %}
