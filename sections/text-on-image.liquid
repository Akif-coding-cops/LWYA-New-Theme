{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .dlfl {
    flex-direction:column-reverse;
  }
  .dlfl>* {
    flex:100%;
  }
  .first_image_lwya img,.Second_image_lwya img {
    width:100%;
    height:100%;
    object-fit:cover;
  }
  first_image_lwya svg,.Second_image_lwya svg {
    width:100%;
  }
  .Second_image_lwya {
    position:relative;
    border-radius:0 8px 8px 0;
  }
  .Second_image_lwya img {
    border-radius:0 8px 8px 0;
  }
  .first_image_lwya img{
      border-radius:8px 0 0 8px;
    
  }
  .psab--txt {
    position:absolute;
    left:10px;
    top:33px;
    color:#FBFFFF;
  }
  .fs--txt {
      text-edge: cap;
      font-size: 32px;
      font-style: normal;
      font-weight: 700;
      line-height: 90%; /* 57.6px */
      text-transform: uppercase;
  }
  .fs--txt p {
    color:white !important;
  }
  .btn--fs {
        font-size: 16px;
        font-style: normal;
        font-weight: 700;
        line-height: 120%; /* 24px */
        text-transform: uppercase;
      border-radius: 8px;
       border: 3px solid  #FBFFFF;
  }
  .btn--width {
      display: inline-flex;
      padding: 16px 24px;
      justify-content: center;
      align-items: center;
      gap: 10px;
      border-radius:8px;
        }
  a.btn--width {
     color:#FBFFFF;
    text-decoration:none;
  }
  .fw--adjust p{
    margin:0;
  }
  .btn--width {
    margin-top:24px;
  }
  @media screen and (min-width: 750px) {
     .psab--txt {
    max-width:20rem;
     }
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .dlfl {
      flex-direction:row;
      display:flex;
  }
     .fs--txt {
      text-edge: cap;
      font-size: 64px;
      font-style: normal;
      font-weight: 700;
      line-height: 90%; /* 57.6px */
      text-transform: uppercase;
  }
  .btn--fs {
        leading-trim: both;
        text-edge: cap;
        font-size: 20px;
        font-style: normal;
        font-weight: 700;
        line-height: 120%; /* 24px */
        text-transform: uppercase;
  }
  }
{%- endstyle -%}
<div class="dlfl container section-{{ section.id }}-padding">
   <div class="first_image_lwya">
  {% if section.settings.fitrs_image_text !=blank %}
    {{ 
    section.settings.fitrs_image_text
    |image_url: width:3000
    |image_tag
    }}
     {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
     </div>
    <div class="Second_image_lwya">
  {% if section.settings.Second_image_text !=blank %}

    {{ 
    section.settings.Second_image_text
    |image_url: width:3000
    |image_tag
    }}
     {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    <div class="psab--txt">
    <div class="fs--txt fw--adjust globalClassInria_Sans">
      {{ section.settings.text_on_image }}
    </div>
    <a class="btn--fs btn--width inria-sans-regular_global" href="{{ section.settings.button_link }}">
    {{ section.settings.button_label_image }}
    </a>
    </div>
  </div>
  </div>
{% schema %}
          {
            "name": "Text on image",
            "settings": [
              {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_bottom",
      "default": 36
    },
              {
          "type": "image_picker",
          "id": "fitrs_image_text",
          "label": "Image 1"
        },
              {
          "type": "image_picker",
          "id": "Second_image_text",
          "label": "Image 2"
        },
        {
          "type": "richtext",
          "id": "text_on_image",
          "label": "Paragraph"
        },
         {
      "type": "text",
      "id": "button_label_image",
      "label": "Button Label",
      "default": "Quick links"
    },
    {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
            ],
              "presets": [
                {
                  "name": "Text on image"
                }
              ]
        }
{% endschema %}