<div class="custom_text_container container">
  <div class="background__meta">
        <div class="inner_title globalClassInria_Sans"> {{ section.settings.line }} </div>
  {% if section.settings.image_text !=blank %}
    <div class="custom_icon">
            <div class="stars_image"> 
              {{
                section.settings.image_text
                | image_url: width: 1500
                | image_tag
              }} 
            </div>
         <div class="simple_text inria-sans-regular_global"> {{ section.settings.line3 }} </div>
  </div>
    {% endif %}
       <div class="inner_content inria-sans-regular_global">  {{ section.settings.line2 }} </div>
  </div>
</div>
{% schema %}
  {
    "name": "Featured text",
    "settings": [
              {
          "type": "inline_richtext",
          "id": "line",
          "label": "Heading"
        },
         {
            "type": "image_picker",
            "id": "image_text",
            "label": "Select image"
          },
         {
            "type": "inline_richtext",
            "id": "line3",
            "label": "Description"
          },
          {
          "type": "inline_richtext",
          "id": "line2",
          "label": "Description"
        },
   
    ],
  "presets": [
    {
      "name": "Featured text"
    }
  ]
  }
  {% endschema %}