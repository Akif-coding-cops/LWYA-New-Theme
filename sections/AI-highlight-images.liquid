{% schema %}
{
  "name": "Highlight Images",
  "tag": "section",
  "class": "highlight-images",
  "settings": [
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 200,
      "step": 8,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 200,
      "step": 8,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap (between images in same row)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row Gap (between rows)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Highlight Images"
    }
  ]
}
{% endschema %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variant_highlight_images = current_variant.metafields.custom.variant_highlight_images.value
  assign highlight_images = null

  if variant_highlight_images != blank and variant_highlight_images.size > 0
    assign highlight_images = variant_highlight_images
  else
    assign highlight_images = product.metafields.custom.highlight_images.value
  endif
-%}

{% if highlight_images != blank %}
  <section
    class="tw-w-full highlight-images-section"
    style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
  >
    <style>
      .hi-desktop {
        display: block;
      }
      .hi-mobile {
        display: none;
      }
      @media (min-width: 768px) {
        .hi-desktop {
          display: block;
        }
        .hi-mobile {
          display: none;
        }
      }
      @media (max-width: 767px) {
        .hi-desktop {
          display: none;
        }
        .hi-mobile {
          display: block;
        }
      }
      .hi-video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
      }
    </style>

    <div
      class="tw-grid tw-grid-cols-12 tw-w-full tw-max-w-[1400px] tw-mx-auto"
      style="column-gap: {{ section.settings.column_gap }}px; row-gap: {{ section.settings.row_gap }}px;"
    >
      {% for item in highlight_images %}
        {%- assign cols = item.columns | default: 12 -%}
        {%- assign img = item.image -%}
        {%- assign img_mobile = item.mobile_image -%}
        {%- assign vid = item.video.value.sources[1].url -%}
        {%- assign vid_mobile = item.mobile_video.value.sources[1].url -%}

        {%- comment -%} Determine what will actually render on each viewport {%- endcomment -%}
        {%- assign has_desktop = false -%}
        {%- assign has_mobile = false -%}
        {%- if img != blank or vid != blank -%}{%- assign has_desktop = true -%}{%- endif -%}
        {%- if img_mobile != blank or vid_mobile != blank -%}{%- assign has_mobile = true -%}{%- endif -%}

        {%- comment -%}
          If nothing at all is provided, skip the item entirely.
          If only desktop OR only mobile is provided we still render —
          the empty side just shows nothing (display:none handles it).
        {%- endcomment -%}
        {% unless has_desktop or has_mobile %}{% continue %}{% endunless %}

        <div class="tw-col-span-12 md:tw-col-span-{{ cols }}">
          <div
            class="tw-w-full tw-h-full {% if item.apply_horizontal_padding == true %}tw-px-[16px] md:tw-px-[24px] lg:tw-px-[60px] xxl:tw-px-0{% endif %}"
            style="margin: 0 auto;"
          >
            {%- comment -%} ── DESKTOP MEDIA ── {%- endcomment -%}
            <div class="hi-desktop">
              {% if img != blank %}
                <img
                  src="{{ img | image_url: width: 1600 }}"
                  srcset="
                    {{ img | image_url: width: 800 }} 800w,
                    {{ img | image_url: width: 1200 }} 1200w,
                    {{ img | image_url: width: 1600 }} 1600w
                  "
                  sizes="{{ cols | times: 100 | divided_by: 12 }}vw"
                  alt="{{ img.alt | default: product.title }}"
                  class="tw-w-full tw-h-full tw-object-cover tw-block"
                  loading="lazy"
                >
              {% elsif vid != blank %}
                <video
                  class="hi-video"
                  src="{{ vid }}"
                  autoplay
                  muted
                  loop
                  playsinline
                ></video>
              {% endif %}
            </div>

            {%- comment -%} ── MOBILE MEDIA ── {%- endcomment -%}
            <div class="hi-mobile">
              {% if img_mobile != blank %}
                <img
                  src="{{ img_mobile | image_url: width: 800 }}"
                  srcset="
                    {{ img_mobile | image_url: width: 400 }} 400w,
                    {{ img_mobile | image_url: width: 800 }} 800w
                  "
                  sizes="100vw"
                  alt="{{ img_mobile.alt | default: product.title }}"
                  class="tw-w-full tw-h-full tw-object-cover tw-block"
                  loading="lazy"
                >
              {% elsif vid_mobile != blank %}
                <video
                  class="hi-video"
                  src="{{ vid_mobile }}"
                  autoplay
                  muted
                  loop
                  playsinline
                ></video>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}
