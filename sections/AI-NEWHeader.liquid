<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: 1rem;
    position: relative;
    z-index: 4;
  }

  /* Header height and max-width */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header.container {
      min-height: 143px;
      max-width: 1440px;
      margin-left: auto;
      margin-right: auto;
      border-radius: 0 !important;
      transition: min-height 0.3s ease;
    }
  }

  /* Scroll behavior - shrink header */
  .is-scrolling #shopify-section-{{ section.id }} .header.container {
    min-height: 90px;
  }

  /* Background image positioning */
  #shopify-section-{{ section.id }} .header.container {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .header-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    object-position: {{ section.settings.bg_position_x_mobile }}% {{ section.settings.bg_position_y_mobile }}%;
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header-background-image {
      object-position: {{ section.settings.bg_position_x }}% {{ section.settings.bg_position_y }}%;
    }
  }

  /* Ensure content is above background */
  #shopify-section-{{ section.id }} .header__logo,
  #shopify-section-{{ section.id }} .header__secondary-nav {
    position: relative;
    z-index: 1;
  }

  /* Logo centering with CSS Grid */
  {%- if section.settings.center_logo_no_menu -%}
  #shopify-section-{{ section.id }} .header.container {
    display: grid !important;
    grid-template-columns: 1fr auto 1fr !important;
    align-items: center !important;
  }

  #shopify-section-{{ section.id }} .header__logo {
    grid-column: 2 !important;
    justify-self: center !important;
  }

  #shopify-section-{{ section.id }} .header__secondary-nav {
    grid-column: 3 !important;
    justify-self: end !important;
  }
  {%- endif -%}

  /* Custom cart icon styling */
  #shopify-section-{{ section.id }} .header__secondary-nav img[alt="Cart"] {
    width: 27px !important;
    height: 27px !important;
    filter: contrast(1.3);
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}
</style>

<script>
  // Scroll detection with hysteresis to prevent flickering
  (function() {
    let isScrolled = false;
    const scrollDownThreshold = 100;
    const scrollUpThreshold = 50;

    window.addEventListener('scroll', function() {
      const scrollPosition = window.scrollY;
      
      if (!isScrolled && scrollPosition > scrollDownThreshold) {
        isScrolled = true;
        document.documentElement.classList.add('is-scrolling');
      } else if (isScrolled && scrollPosition < scrollUpThreshold) {
        isScrolled = false;
        document.documentElement.classList.remove('is-scrolling');
      }
    });
  })();
</script>

<height-observer variable="header">
  <x-header {% if section.settings.hide_on_scroll and section.settings.enable_sticky %}hide-on-scroll{% endif %} class="header container color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    {%- if section.settings.background_image != blank -%}
      <img
        src="{{ section.settings.background_image | image_url: width: 1440 }}"
        alt="Header background"
        class="header-background-image"
        width="1440"
        height="300"
        loading="eager"
      >
    {%- endif -%}

    {%- comment -%}LOGO{%- endcomment -%}
    {%- capture logo_content -%}
      {%- if section.settings.logo -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}
        <span class="sr-only">{{ shop.name }}</span>
        {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image' -}}
      {%- else -%}
        <span class="header__logo-text h5">{{ shop.name }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
    {% endif %}

    {%- comment -%}SECONDARY NAV{%- endcomment -%}
    <nav class="header__secondary-nav">
      {%- if section.settings.show_account_icon and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-item-link tap-area" {% if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' %}aria-current="page"{% endif %}>
          {%- render 'icon' with 'account', width: 20, height: 20 -%}
          <span class="sr-only">{{ 'header.general.account' | t }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_search_icon -%}
        <button type="button" class="header__action-item-link tap-area" is="custom-button" aria-controls="search-drawer" aria-expanded="false" aria-label="{{ 'search.general.title' | t | escape }}">
          {%- render 'icon' with 'search', width: 20, height: 20 -%}
        </button>
      {%- endif -%}

      {%- if section.settings.show_cart_icon -%}
        <a href="{{ routes.cart_url }}" class="header__action-item-link tap-area" {% if settings.cart_type == 'drawer' and request.page_type != 'cart' %}is="custom-button" aria-controls="cart-drawer" aria-expanded="false"{% endif %} aria-label="{{ 'header.general.cart' | t | escape }}">
          <img src="{{ 'cartnew.png' | asset_url }}" alt="Cart" width="27" height="27" style="display: block;">
        </a>
      {%- endif -%}
    </nav>
  </x-header>
</height-observer>

{% schema %}
{
  "name": "AI New Header",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional background image for the header"
    },
    {
      "type": "range",
      "id": "bg_position_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position X (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "bg_position_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position Y (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "bg_position_x_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position X (mobile)",
      "default": 50
    },
    {
      "type": "range",
      "id": "bg_position_y_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background position Y (mobile)",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional: Upload a custom logo"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_mobile_max_width",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 100
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Hide on scroll down",
      "info": "Only works with sticky header enabled",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "center_logo_no_menu",
      "label": "Center logo (no menu)",
      "info": "Centers logo when no main menu is present",
      "default": true
    },
    {
      "type": "header",
      "content": "Icon visibility"
    },
    {
      "type": "checkbox",
      "id": "show_account_icon",
      "label": "Show account icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_search_icon",
      "label": "Show search icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cart_icon",
      "label": "Show cart icon",
      "default": true
    }
  ]
}
{% endschema %}
