            <td class="lwya-clean-list__inci">Retinyl Palmitate</td>
          </tr>
          <tr>
            <td>Styrene Based Ingredients</td>
            <td><span class="lwya-clean-list__badge lwya-clean-list__badge--prohibited">Prohibited</span></td>
