            <td>Foaming and cleansing agents</td>
            <td class="lwya-clean-list__inci">Sodium Lauryl Sulfate (SLS)<br>Sodium Laureth Sulfate (SLES)</td>
          </tr>
          <tr>
            <td>Talc</td>
            <td><span class="lwya-clean-list__badge lwya-clean-list__badge--prohibited">Prohibited</span></td>
            <td>Formula base, absorbent and bulking agent</td>
            <td class="lwya-clean-list__inci">Talc</td>
          </tr>
          <tr>
            <td>Toluene Based Ingredients</td>
            <td><span class="lwya-clean-list__badge lwya-clean-list__badge--prohibited">Prohibited</span></td>
            <td>Solvents and stabilizers</td>
            <td class="lwya-clean-list__inci">2,6-Dihydroxyethylaminotoluene<br>4-Amino-2-Hydroxytoluene<br>4-Amino-2-Hydroxytoluene Sulfate<br>4-Methoxytoluene-2,5-Diamine HCl<br>Methylstyrene/Vinyltoluene Copolymer<br>N,N-Diethyltoluene-2,5-Diamine HCl<br>Potassium Toluenesulfonate<br>Sodium Toluenesulfonate<br>Toluene<br>Toluene Sulfonic Acid<br>Toluene-2,5-Diamine<br>Toluene-2,5-Diamine Sulfate<br>Toluene-2,6-Diamine<br>Toluene-3,4-Diamine</td>
          </tr>
          <tr>
            <td>Triclosan and Triclocarban</td>
            <td><span class="lwya-clean-list__badge lwya-clean-list__badge--prohibited">Prohibited</span></td>
            <td>Sanitizers, preservatives and odor-fighting agents</td>
            <td class="lwya-clean-list__inci">Triclosan<br>Triclocarban</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LWYA Clean List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LWYA Beauty — Prohibited & Restricted Ingredients"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our commitment to clean beauty means every formula is free from the ingredients listed below."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "LWYA Clean List"
    }
  ]
}
{% endschema %}
