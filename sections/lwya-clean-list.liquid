            <td><span class="lwya-clean-list__badge lwya-clean-list__badge--prohibited">Prohibited</span></td>
            <td>Stabilizer and denaturant</td>
            <td class="lwya-clean-list__inci">Resorcinol</td>
          </tr>
          <tr>
            <td>Retinyl Palmitate</td>
            <td><span class="lwya-clean-list__badge lwya-clean-list__badge--prohibited">Prohibited</span></td>
