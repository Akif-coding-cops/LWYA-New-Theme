{% schema %}
{
  "name": "LWYA Promise",
  "tag": "section",
  "class": "lwya-promise",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The LWYA Promise"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F4F0E7"
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding top/bottom",
      "min": 20,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding left/right (desktop)",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 115
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Promise item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "richtext",
          "id": "label",
          "label": "Text",
          "default": "<p>Paraben Free</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "LWYA Promise",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}

{% unless product.metafields.custom.hide_our_values == true %}
  <style>
    .lwya-promise-{{ section.id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: {{ section.settings.bg_color }};
      opacity: {{ section.settings.bg_opacity | divided_by: 100.0 }};
      z-index: 0;
    }
    .lwya-promise-{{ section.id }} > * {
      position: relative;
      z-index: 1;
    }
    .lwya-promise-content{
      text-align: center;
      font-size: 25px;
      font-family: 'Gotham-Book' !important;
      margin-top: 50px;
      color: #00000066;
    }
    .lwya-promise-heading {
      font-family: 'Gotham-Book' !important;
      font-size: 3rem !important;
    }
  </style>

  <section
    class="tw-max-w-[1400px] tw-mx-auto tw-relative lwya-promise-{{ section.id }}"
    style="padding-top: {{ section.settings.padding_y }}px; padding-bottom: {{ section.settings.padding_y }}px;"
  >
    <div class="tw-max-w-[1400px] tw-mx-auto tw-text-center tw-px-[16px] lg:tw-px-[{{ section.settings.padding_x }}px]">
      <h2
        style="color: {{ section.settings.heading_color }}; font-size: clamp(24px, 3vw, 38px); font-weight: 400;"
        class="lwya-promise-heading"
      >
        {{ section.settings.heading }}
      </h2>

      <div class="tw-grid tw-grid-cols-2 md:tw-grid-cols-3 lg:tw-grid-cols-6 tw-gap-[20px] tw-mt-[45px] md:tw-mt-[90px]">
        {% for block in section.blocks %}
          {% if block.type == 'value' %}
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-[14px]" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="tw-w-[81px] tw-h-[81px] tw-flex tw-items-center tw-justify-center">
                  <img
                    src="{{ block.settings.icon | image_url: width: 200 }}"
                    alt="{{ block.settings.label | escape }}"
                    class="tw-max-w-[81px] tw-max-h-[81px] tw-w-auto tw-h-auto tw-object-contain"
                    loading="lazy"
                  >
                </div>
              {% endif %}
              <div class="tw-text-[14px] md:tw-text-[22px] tw-leading-[1.4] tw-text-[#000000]">
                {{ block.settings.label }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  <div class="lwya-promise-content">
      <a href="{{ section.settings.link_url | default: '#' }}" target="_blank" rel="noopener">Click Here to see extensive list</a>
    </div>
  </section>

{% endunless %}