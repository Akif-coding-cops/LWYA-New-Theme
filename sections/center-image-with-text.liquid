<style>
 .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
          padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
        }
      .child__container {
        display:flex;
      }
      .blocks__images img{
        width:100%;
        height:100%;
        object-fit:cover;
        position:relative;
      }
  .top_heading,bottom_heading{
    color:#1C1D52;
    position:absolute;
  }
  .blocks__images.varr__1,.blocks__images.varr__3 {
    width:37.5%;
    height:100%;
  }
  .blocks__images.varr__2 {
     width:24.5%;
     height:100%;
  }
      }
  @media screen and (max-width:760px){
     .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
      }
</style>
<div class="container section-{{ section.id }}-padding">
<div class="child__container">
{% for block in section.blocks %}
  {% if block.settings.images__center != blank %}
  <div class="blocks__images varr__{{ forloop.index }}">
    {{ 
      block.settings.images__center
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
    <div class="top_heading">
      {{ block.settings.Dare_to_shine_text }}
    </div>
    <div class="bottom_heading">
      {{ block.settings.manufactured_inline_bottom_text }}
    </div>
  </div>
    {% endif %}
  {% endfor %}
  
</div>
  
</div>

{% schema %}
  {
    "name": "Text on center image",
    "settings": [
       {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_bottom",
      "default": 36
    }
    ],
    "blocks": [
      {
        "type": "images_block",
        "name":"image",
        "settings": [
             {
        "type": "image_picker",
        "id": "images__center",
        "label": "Select Image"
      },
      {
  "type": "select",
  "id": "Image_Position",
  "label": "Image Position",
  "options": [
    {
      "value": "left",
      "label": "Left"
    },
    {
      "value": "right",
      "label": "Right"
    }
  ],
  "default": "right"
},
      {
        "type": "text",
        "id": "Dare_to_shine_text",
        "label": "text"
      },
      {
        "type": "text",
        "id": "manufactured_inline_bottom_text",
        "label": "Bottom Heading"
      }
        ]
      }
    ],
    "presets": [
      {
        "name": "Text on center image"
      }
    ]
  }
{% endschema %}