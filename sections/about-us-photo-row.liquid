{%- style -%}
  .au-photo-row {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .au-photo-row__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.gap }}px;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }
  .au-photo-row__item {
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .au-photo-row__item img,
  .au-photo-row__item svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (min-width: 600px) {
    .au-photo-row__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .au-photo-row {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .au-photo-row__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{%- endstyle -%}

<div class="au-photo-row">
  <div class="au-photo-row__grid">
    {%- for i in (1..3) -%}
      {%- assign img_key = 'image_' | append: i -%}
      {%- assign img = section.settings[img_key] -%}
      {%- assign alt_key = 'image_' | append: i | append: '_alt' -%}
      {%- assign alt = section.settings[alt_key] -%}
      <div class="au-photo-row__item">
        {%- if img != blank -%}
          <img
            src="{{ img | image_url: width: 800 }}"
            srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 800 }} 800w"
            sizes="(min-width: 1400px) 467px, 33vw"
            alt="{{ alt | escape }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "AU - Photo Row",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Image 3 alt text"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between photos",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Container width",
      "min": 800,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "AU - Photo Row"
    }
  ]
}
{% endschema %}
