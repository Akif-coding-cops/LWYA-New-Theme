{% assign video_metafield = product.metafields.custom.custom_product_videos %}
{% assign product_videos = video_metafield.value %}

{% if video_metafield and product_videos %}
  <div class="product-videos-container">  
    <div class="swiper myVideoSwiper">
      <div class="swiper-wrapper">
        {% for file in product_videos %}
          <div class="swiper-slide">
            {{ file | video_tag: autoplay: true, loop: true, muted: true, controls: true }}
          </div>
        {% endfor %}
      </div>

      <!-- Swiper arrows -->
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </div>
{% endif %}



<style>
  /* Style for the container */
  .product-videos-container {
    max-width: 1300px;
    padding: 20px;
    margin: auto;
    background: #F6F6F6;
    border-radius:20px;
}

