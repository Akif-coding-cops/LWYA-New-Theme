  .product-videos-container {
  padding: 30px 20px;
}

.product-videos-container .myVideoSwiper video {
  width: 100%;
  height: auto;
  border-radius: 10px;
}

.product-videos-container .swiper-button-next,
.product-videos-container .swiper-button-prev {
  color: rgb(255 255 255);
  background-color: #FF6FAB !important;
  padding: 0px 22px;
  border-radius:100px;
}
.product-videos-container .swiper-button-next:after,
.product-videos-container .swiper-button-prev:after{
  font-size:15px;
  
}  
@media (max-width:768px){
  .product-videos-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);  /* 4 columns, each taking equal space */
  gap: 20px;  /* Space between the videos */
}
}
  @media (max-width:767px){
  .product-videos-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);  /* 4 columns, each taking equal space */
  gap: 20px;  /* Space between the videos */
}
}
</style>

{% schema %}
{
  "name": "Product Videos",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "text",
      "id": "video_section_title",
      "label": "Section Title",
      "default": "Product Videos"
    },
    {
      "type": "range",
      "id": "video_grid_columns",
      "label": "Number of Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "video_metafield_key",
      "label": "Metafield Key",
      "default": "custom.custom_product_videos",
      "info": "Enter the metafield namespace and key (e.g., custom.custom_product_videos)"
    }
  ],
  "presets": [
    {
      "name": "Product Videos",
      "category": "Media"
    }
  ]
}
{% endschema %}
