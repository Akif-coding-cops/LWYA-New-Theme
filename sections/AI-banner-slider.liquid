<style>
  #shopify-section-{{ section.id }} {
    background-color: #ffffff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .ai-bslider {
    max-width: 1400px;
    margin: 0 auto;
    overflow: hidden;
  }

  /* Each slide is a flex row — desktop panels sit side by side */
  #shopify-section-{{ section.id }} .swiper-slide {
    display: flex;
    align-items: stretch;
    height: {{ section.settings.height_desktop }}px;
    text-decoration: none;
    position: relative;
  }

  #shopify-section-{{ section.id }} .ai-bs__panel {
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .ai-bs__video,
  #shopify-section-{{ section.id }} .ai-bs__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile image: hidden on desktop */
  #shopify-section-{{ section.id }} .ai-bs__mobile-img {
    display: none;
  }

  #shopify-section-{{ section.id }} .swiper-pagination {
    bottom: 12px;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet-active {
    background: #d41870;
  }

  @media (max-width: 767px) {
    /* Auto height on mobile — image defines the slide height, nothing gets cropped */
    #shopify-section-{{ section.id }} .swiper-slide {
      height: auto;
    }

    /* Hide all desktop panels on mobile */
    #shopify-section-{{ section.id }} .ai-bs__panel {
      display: none;
    }

    /* Show the single mobile image for this slide at its natural height */
    #shopify-section-{{ section.id }} .ai-bs__mobile-img {
      display: block;
      width: 100%;
      height: auto;
    }
  }
</style>

<div class="ai-bslider">
  <div class="swiper js-ai-bs-{{ section.id }}">
    <div class="swiper-wrapper">

      {%- for block in section.blocks -%}
        {%- unless block.type == 'slide' -%}{%- continue -%}{%- endunless -%}

        {%- assign slide_link = block.settings.slide_link -%}

        {%- comment -%} Use <a> when a link is set, <div> otherwise {%- endcomment -%}
        {%- if slide_link != blank -%}
          <a href="{{ slide_link }}" class="swiper-slide" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
        {%- endif -%}

          {%- comment -%} Mobile: one full-width image per slide {%- endcomment -%}
          {%- if block.settings.mobile_image != blank -%}
            <img
              src="{{ block.settings.mobile_image | image_url: width: 800 }}"
              width="800"
              height="800"
              alt="{{ block.settings.mobile_image.alt | default: '' }}"
              loading="lazy"
              class="ai-bs__mobile-img"
            >
          {%- endif -%}

          {%- comment -%} Desktop: up to 3 panels, each an image or video with a configurable width {%- endcomment -%}
          {%- if block.settings.p1_image != blank or block.settings.p1_video != blank -%}
            {%- render 'ai-banner-panel',
              image: block.settings.p1_image,
              video: block.settings.p1_video,
              width: block.settings.p1_width
            -%}
          {%- endif -%}

          {%- if block.settings.p2_image != blank or block.settings.p2_video != blank -%}
            {%- render 'ai-banner-panel',
              image: block.settings.p2_image,
              video: block.settings.p2_video,
              width: block.settings.p2_width
            -%}
          {%- endif -%}

          {%- if block.settings.p3_image != blank or block.settings.p3_video != blank -%}
            {%- render 'ai-banner-panel',
              image: block.settings.p3_image,
              video: block.settings.p3_video,
              width: block.settings.p3_width
            -%}
          {%- endif -%}

        {%- if slide_link != blank -%}</a>{%- else -%}</div>{%- endif -%}

      {%- endfor -%}

    </div>

    <div class="swiper-pagination"></div>
  </div>
</div>

<script>
  (function () {
    function initSlider() {
      new Swiper('.js-ai-bs-{{ section.id }}', {
        loop: true,
        speed: 600,
        autoHeight: true,
        autoplay: {
          delay: {{ section.settings.autoplay_delay | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        pagination: {
          el: '.js-ai-bs-{{ section.id }} .swiper-pagination',
          clickable: true
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlider);
    } else {
      initSlider();
    }

    // Re-init when section is reloaded in the theme editor
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === '{{ section.id }}') initSlider();
    });
  })();
</script>

{% schema %}
{
  "name": "AI Banner Slider",
  "tag": "section",
  "class": "ai-banner-slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay (seconds per slide)",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Slide Height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "info": "Mobile height is automatic — the image defines it",
      "min": 200,
      "max": 900,
      "step": 20,
      "default": 560,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Mobile"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "Shown full-width on mobile. All desktop panels are hidden on mobile."
        },
        {
          "type": "header",
          "content": "Desktop — Panel 1"
        },
        {
          "type": "image_picker",
          "id": "p1_image",
          "label": "Image",
          "info": "Use either Image or Video — not both"
        },
        {
          "type": "video",
          "id": "p1_video",
          "label": "Video"
        },
        {
          "type": "range",
          "id": "p1_width",
          "label": "Width %",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 50,
          "info": "All panel widths in a slide should total 100"
        },
        {
          "type": "header",
          "content": "Desktop — Panel 2 (optional)"
        },
        {
          "type": "image_picker",
          "id": "p2_image",
          "label": "Image",
          "info": "Use either Image or Video — not both"
        },
        {
          "type": "video",
          "id": "p2_video",
          "label": "Video"
        },
        {
          "type": "range",
          "id": "p2_width",
          "label": "Width %",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 50
        },
        {
          "type": "header",
          "content": "Desktop — Panel 3 (optional)"
        },
        {
          "type": "image_picker",
          "id": "p3_image",
          "label": "Image",
          "info": "Use either Image or Video — not both"
        },
        {
          "type": "video",
          "id": "p3_video",
          "label": "Video"
        },
        {
          "type": "range",
          "id": "p3_width",
          "label": "Width %",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 35
        },
        {
          "type": "header",
          "content": "Link"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "AI Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
