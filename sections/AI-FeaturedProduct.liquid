{% schema %}
{
  "name": "Featured products (3)",
  "tag": "section",
  "class": "featured-3-grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_product_links",
      "label": "Enable product page links",
      "info": "When enabled, clicking on product cards will navigate to product pages",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text (under each product)",
      "default": "<p>30 DAY MONEY BACK GUARANTEED.<br>NO AUTOSHIP - NO COMMITMENT</p>"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Sale label color",
      "default": "#BED034"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#BED034"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding top/bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)"
        },
        {
          "type": "text",
          "id": "rating_value",
          "label": "Rating value",
          "default": "4.8"
        },
        {
          "type": "text",
          "id": "rating_count",
          "label": "Rating count",
          "default": "(xx)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "ADD TO CART"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Featured products (3)",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}

<section
  id="AI-FeaturedProduct"
  class="tw-w-full"
  style="background: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_y }}px; padding-bottom: {{ section.settings.padding_y }}px;"
>
  <div class="tw-max-w-[1440px] tw-mx-auto tw-px-[16px] md:tw-px-0">
    <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-3 tw-gap-[5px]">
      {% for block in section.blocks %}
        {% if block.type == 'product_item' %}
          {% assign prod = block.settings.product %}
          {% if prod != blank %}
            {% assign product_obj = all_products[prod] %}
          {% endif %}

          <div class="tw-flex tw-flex-col tw-bg-[#FFFFFF] tw-h-full" {{ block.shopify_attributes }}>
            {% if section.settings.enable_product_links %}
              <a href="{% if product_obj != blank %}{{ product_obj.url }}{% else %}#{% endif %}" class="tw-block">
            {% else %}
              <div class="tw-block">
            {% endif %}
              {% if product_obj.featured_image %}
                <div class="tw-w-full tw-relative tw-bg-[#f3f3f3] tw-overflow-hidden product-image-container {% if product_obj.images[1] %}has-second-image{% endif %}">
                  <img
                    src="{{ product_obj.featured_image | image_url: width: 900 }}"
                    alt="{{ product_obj.featured_image.alt | escape }}"
                    class="tw-w-full tw-h-full tw-object-cover product-image-main"
                    loading="lazy"
                  >
                  {% if product_obj.images[1] %}
                    <img
                      src="{{ product_obj.images[1] | image_url: width: 900 }}"
                      alt="{{ product_obj.images[1].alt | escape }}"
                      class="tw-w-full tw-h-full tw-object-cover product-image-hover tw-absolute tw-top-0 tw-left-0 tw-opacity-0"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              {% endif %}
            {% if section.settings.enable_product_links %}
              </a>
            {% else %}
              </div>
            {% endif %}

            <div class="tw-px-[14px] tw-pt-[14px] tw-pb-[18px] tw-flex-1 tw-flex tw-flex-col tw-max-w-[90%]">
              {% if section.settings.enable_product_links %}
                <a href="{% if product_obj != blank %}{{ product_obj.url }}{% else %}#{% endif %}" class="tw-block tw-no-underline">
              {% else %}
                <div class="tw-block">
              {% endif %}
              {% comment %} title {% endcomment %}
              {% if block.settings.custom_title != blank %}
                <h3 class="tw-text-[16px] tw-font-[600] tw-text-[#000000]">
                  {{ block.settings.custom_title }}
                </h3>
              {% elsif product_obj != blank %}
                <h3 class="tw-text-[16px] tw-font-[600] tw-text-[#000000]">
                  {{ product_obj.title }}
                </h3>
              {% else %}
                <h3 class="tw-text-[16px] tw-font-[600] tw-text-[#000000]">
                  Product title
                </h3>
              {% endif %}

              {% comment %} rating {% endcomment %}
              <div class="tw-flex tw-items-center tw-gap-[5px] tw-mt-[4px]">
                <div class="tw-flex tw-text-[#000000] tw-text-[16px] tw-gap-[2px]">
                  ★★★★★
                </div>
                <div class="tw-text-[15px] tw-text-[#000000]">
                  {{ block.settings.rating_value }} {{ block.settings.rating_count }}
                </div>
              </div>

              {% comment %} price logic {% endcomment %}
              {% assign price = product_obj.price | default: 0 %}
              {% assign compare = product_obj.compare_at_price | default: 0 %}
              {% assign has_sale = false %}
              {% if compare > price and price > 0 %}
                {% assign has_sale = true %}
              {% endif %}

              {% if has_sale %}
                {% assign diff = compare | minus: price %}
                {% assign percent = diff | times: 100 | divided_by: compare %}
                <div class="tw-text-[20px] tw-font-[700] tw-mt-[10px]" style="color: {{ section.settings.sale_color }};">
                  {{ percent }}% OFF
                </div>
              {% else %}
                <div class="tw-mt-[10px]"></div>
              {% endif %}

              <div class="tw-flex tw-items-center tw-gap-[10px] tw-mt-[6px]">
                {% if has_sale %}
                  <span class="tw-text-[20px] tw-font-[700] tw-line-through" style="color: {{ section.settings.sale_color }};">
                    {{ compare | money }}
                  </span>
                  <span class="tw-text-[20px] tw-font-[700] tw-text-[#000000]">
                    {{ price | money }}
                  </span>
                {% else %}
                  <span class="tw-text-[20px] tw-font-[700] tw-text-[#000000]">
                    {% if price > 0 %}
                      {{ price | money }}
                    {% else %}
                      —
                    {% endif %}
                  </span>
                {% endif %}
              </div>
              {% if section.settings.enable_product_links %}
                </a>
              {% else %}
                </div>
              {% endif %}

              {% comment %} button {% endcomment %}
              {% if product_obj != blank %}
                {% assign first_variant = product_obj.selected_or_first_available_variant %}
                {% if first_variant %}
                  <button
                    type="button"
                    class="add-to-cart-btn tw-mt-[14px] tw-py-[10px] tw-text-[14px] tw-font-[600] tw-text-center tw-transition-all tw-duration-300 tw-max-w-[50%]"
                    style="background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};"
                    data-variant-id="{{ first_variant.id }}"
                    onclick="event.stopPropagation();"
                  >
                    {{ block.settings.button_label }}
                  </button>
                {% endif %}
              {% endif %}

              <div class="tw-mt-[16px] footer-richtext">
                {{ section.settings.footer_text }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    .footer-richtext {
      font-size: 11px;
      line-height: 1.3;
      color: #000000;
      text-transform: uppercase;
    }
    .footer-richtext p {
      margin: 0;
    }
    .footer-richtext strong {
      font-weight: 700;
    }
    .footer-richtext em {
      font-style: italic;
    }
    .product-image-container.has-second-image:hover .product-image-hover {
      opacity: 1 !important;
    }
    .product-image-container.has-second-image:hover .product-image-main {
      opacity: 0 !important;
    }
    .product-image-container:hover img {
      transform: scale(1.08);
    }
    .product-image-main,
    .product-image-hover {
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .add-to-cart-btn:hover {
      filter: brightness(0.85);
    }
  </style>

  <script>
    (function() {
      var root = document.currentScript && document.currentScript.closest
        ? document.currentScript.closest('section')
        : null;
      if (!root) return;
      var buttons = root.querySelectorAll('.add-to-cart-btn');
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.getAttribute('data-variant-id');
          if (!id) return;
          var formData = new FormData();
          formData.append('id', id);
          formData.append('quantity', 1);
          fetch('/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            // Trigger Rebuy cart drawer
            if (window.Rebuy && window.Rebuy.SmartCart) {
              window.Rebuy.SmartCart.show();
            }
            
            // Dispatch custom events for cart update
            var variantEvt = new CustomEvent('variant:add', { 
              detail: { 
                variant: data,
                quantity: 1 
              } 
            });
            document.documentElement.dispatchEvent(variantEvt);
            
            var cartEvt = new CustomEvent('cart:change');
            document.documentElement.dispatchEvent(cartEvt);
          })
          .catch(function(err) {
            console.error('Add to cart error', err);
          });
        });
      });
    })();
  </script>

  {%- comment -%}Sticky Add to Cart Bar for Featured Products{%- endcomment -%}
  <div id="sticky-featured-atc" class="tw-fixed tw-bottom-0 tw-left-0 tw-right-0 tw-z-[999] tw-bg-white tw-shadow-[0_-4px_24px_rgba(0,0,0,0.15)] tw-translate-y-full tw-transition-transform tw-duration-300" style="transform: translateY(100%);">
    <div class="tw-max-w-[1440px] tw-mx-auto tw-px-[16px] md:tw-px-[24px] tw-py-[14px]">
      {%- comment -%}Mobile: Swiper Carousel{%- endcomment -%}
      <div class="md:tw-hidden">
        <link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}">
        <div class="swiper sticky-featured-swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% if block.type == 'product_item' %}
                {% assign prod = block.settings.product %}
                {% if prod != blank %}
                  {% assign product_obj = all_products[prod] %}
                  {% assign first_variant = product_obj.selected_or_first_available_variant %}
                  
                  <div class="swiper-slide">
                    <div class="tw-flex tw-items-center tw-gap-[12px] tw-bg-white tw-rounded-[8px] tw-p-[12px] tw-border tw-border-[#e5e5e5]">
                      {%- comment -%}Product Image{%- endcomment -%}
                      {% if product_obj.featured_image %}
                        <img 
                          src="{{ product_obj.featured_image | image_url: width: 100 }}" 
                          alt="{{ product_obj.title }}"
                          class="tw-w-[70px] tw-h-[70px] tw-object-cover tw-rounded-[6px] tw-flex-shrink-0"
                          loading="lazy"
                        >
                      {% endif %}
                      
                      {%- comment -%}Product Info{%- endcomment -%}
                      <div class="tw-flex-1 tw-min-w-0">
                        <h4 class="tw-text-[13px] tw-font-[600] tw-text-black tw-leading-[1.3] tw-mb-[4px] tw-line-clamp-2">
                          {% if block.settings.custom_title != blank %}
                            {{ block.settings.custom_title }}
                          {% else %}
                            {{ product_obj.title }}
                          {% endif %}
                        </h4>
                        
                        {%- comment -%}Price{%- endcomment -%}
                        {% assign price = product_obj.price | default: 0 %}
                        {% assign compare = product_obj.compare_at_price | default: 0 %}
                        {% if compare > price and price > 0 %}
                          <div class="tw-flex tw-items-center tw-gap-[6px] tw-mb-[8px]">
                            <span class="tw-text-[16px] tw-font-[700]" style="color: {{ section.settings.sale_color }};">{{ price | money }}</span>
                            <span class="tw-text-[13px] tw-line-through tw-text-[#999]">{{ compare | money }}</span>
                          </div>
                        {% else %}
                          <div class="tw-text-[16px] tw-font-[700] tw-text-black tw-mb-[8px]">{{ price | money }}</div>
                        {% endif %}
                        
                        {%- comment -%}Add to Cart Button{%- endcomment -%}
                        {% if first_variant %}
                          <button 
                            type="button"
                            class="sticky-atc-btn tw-w-full tw-h-[36px] tw-text-[12px] tw-font-[600] tw-uppercase tw-rounded-[4px] tw-transition-all"
                            style="background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};"
                            data-variant-id="{{ first_variant.id }}"
                            data-product-title="{{ product_obj.title }}">
                            {{ block.settings.button_label | default: 'ADD TO CART' }}
                          </button>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
          <div class="swiper-pagination sticky-featured-pagination"></div>
        </div>
      </div>
      
      {%- comment -%}Desktop: 3 Column Grid{%- endcomment -%}
      <div class="tw-hidden md:tw-grid md:tw-grid-cols-3 tw-gap-[16px]">
        {% for block in section.blocks %}
          {% if block.type == 'product_item' %}
            {% assign prod = block.settings.product %}
            {% if prod != blank %}
              {% assign product_obj = all_products[prod] %}
              {% assign first_variant = product_obj.selected_or_first_available_variant %}
              
              <div class="tw-flex tw-items-center tw-gap-[12px] tw-bg-white tw-rounded-[8px] tw-p-[12px] tw-border tw-border-[#e5e5e5]">
                {%- comment -%}Product Image{%- endcomment -%}
                {% if product_obj.featured_image %}
                  <img 
                    src="{{ product_obj.featured_image | image_url: width: 120 }}" 
                    alt="{{ product_obj.title }}"
                    class="tw-w-[80px] tw-h-[80px] tw-object-cover tw-rounded-[6px] tw-flex-shrink-0"
                    loading="lazy"
                  >
                {% endif %}
                
                {%- comment -%}Product Info{%- endcomment -%}
                <div class="tw-flex-1 tw-min-w-0">
                  <h4 class="tw-text-[14px] tw-font-[600] tw-text-black tw-leading-[1.3] tw-mb-[6px] tw-line-clamp-2">
                    {% if block.settings.custom_title != blank %}
                      {{ block.settings.custom_title }}
                    {% else %}
                      {{ product_obj.title }}
                    {% endif %}
                  </h4>
                  
                  {%- comment -%}Price{%- endcomment -%}
                  {% assign price = product_obj.price | default: 0 %}
                  {% assign compare = product_obj.compare_at_price | default: 0 %}
                  {% if compare > price and price > 0 %}
                    <div class="tw-flex tw-items-center tw-gap-[8px] tw-mb-[10px]">
                      <span class="tw-text-[18px] tw-font-[700]" style="color: {{ section.settings.sale_color }};">{{ price | money }}</span>
                      <span class="tw-text-[14px] tw-line-through tw-text-[#999]">{{ compare | money }}</span>
                    </div>
                  {% else %}
                    <div class="tw-text-[18px] tw-font-[700] tw-text-black tw-mb-[10px]">{{ price | money }}</div>
                  {% endif %}
                  
                  {%- comment -%}Add to Cart Button{%- endcomment -%}
                  {% if first_variant %}
                    <button 
                      type="button"
                      class="sticky-atc-btn tw-w-full tw-h-[40px] tw-text-[13px] tw-font-[600] tw-uppercase tw-rounded-[4px] tw-transition-all"
                      style="background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};"
                      data-variant-id="{{ first_variant.id }}"
                      data-product-title="{{ product_obj.title }}">
                      {{ block.settings.button_label | default: 'ADD TO CART' }}
                    </button>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {%- comment -%}Sticky Bar JavaScript{%- endcomment -%}
  <script>
    (function() {
      const stickyBar = document.getElementById('sticky-featured-atc');
      if (!stickyBar) return;
      
      const featuredSection = document.getElementById('AI-FeaturedProduct');
      if (!featuredSection) return;
      
      let ticking = false;
      let mobileSwiper = null;
      
      // Initialize Swiper for mobile
      if (typeof Swiper !== 'undefined') {
        const swiperEl = stickyBar.querySelector('.sticky-featured-swiper');
        if (swiperEl) {
          mobileSwiper = new Swiper(swiperEl, {
            loop: false,
            spaceBetween: 12,
            slidesPerView: 1,
            speed: 400,
            pagination: {
              el: '.sticky-featured-pagination',
              clickable: true,
              dynamicBullets: false
            }
          });
        }
      }
      
      // Show/hide sticky bar based on scroll
      const handleScroll = () => {
        const currentScrollY = window.scrollY;
        const sectionRect = featuredSection.getBoundingClientRect();
        
        // Show sticky bar when section is scrolled out of view (above viewport)
        if (sectionRect.bottom < -100 && currentScrollY > 400) {
          stickyBar.style.transform = 'translateY(0)';
        } else {
          stickyBar.style.transform = 'translateY(100%)';
        }
        
        ticking = false;
      };
      
      const requestScrollTick = () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      };
      
      window.addEventListener('scroll', requestScrollTick, { passive: true });
      
      // Add to cart functionality for sticky buttons
      const stickyButtons = stickyBar.querySelectorAll('.sticky-atc-btn');
      stickyButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          const variantId = btn.getAttribute('data-variant-id');
          if (!variantId) return;
          
          // Disable button during request
          const originalText = btn.textContent;
          btn.disabled = true;
          btn.textContent = 'ADDING...';
          
          const formData = new FormData();
          formData.append('id', variantId);
          formData.append('quantity', 1);
          
          fetch('/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
          .then(res => res.json())
          .then(data => {
            // Trigger Rebuy cart drawer
            if (window.Rebuy && window.Rebuy.SmartCart) {
              window.Rebuy.SmartCart.show();
            }
            
            // Dispatch custom events for cart update
            document.documentElement.dispatchEvent(new CustomEvent('variant:add', { 
              detail: { 
                variant: data,
                quantity: 1 
              } 
            }));
            
            document.documentElement.dispatchEvent(new CustomEvent('cart:change'));
            
            // Reset button
            btn.disabled = false;
            btn.textContent = originalText;
          })
          .catch(err => {
            console.error('Add to cart error', err);
            btn.disabled = false;
            btn.textContent = originalText;
          });
        });
      });
    })();
  </script>

  <style>
    /* Sticky bar hover effects */
    .sticky-atc-btn:hover {
      filter: brightness(0.9);
      transform: translateY(-1px);
    }
    
    .sticky-atc-btn:active {
      transform: translateY(0);
    }
    
    .sticky-atc-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    
    /* Line clamp utility */
    .tw-line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    /* Custom pagination styling */
    .sticky-featured-pagination {
      position: relative;
      margin-top: 5px !important;
      text-align: center;
      z-index: 10;
    }
    
    .sticky-featured-pagination .swiper-pagination-bullet {
      width: 8px;
      height: 8px;
      background: {{ section.settings.button_bg }};
      opacity: 0.3;
      margin: 0 4px;
      transition: all 0.3s ease;
    }
    
    .sticky-featured-pagination .swiper-pagination-bullet-active {
      opacity: 1;
      width: 24px;
      border-radius: 4px;
      background: {{ section.settings.button_bg }};
    }
  </style>
</section>
