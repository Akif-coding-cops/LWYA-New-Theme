<style>
  #shopify-section-{{ section.id }} {
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .cookie-policy-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
    font-family: var(--text-font-family, sans-serif);
    color: #1a1a1a;
    font-size: 15px;
    line-height: 1.75;
  }

  /* All headings */
  .cookie-policy-body h1,
  .cookie-policy-body h2,
  .cookie-policy-body h3,
  .cookie-policy-body h4,
  .cookie-policy-body h5,
  .cookie-policy-body h6 {
    font-family: var(--heading-font-family, sans-serif);
    font-weight: 700;
    color: #1C1D52;
    line-height: 1.3;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .cookie-policy-body h1 { font-size: 28px; margin-top: 0; }
  .cookie-policy-body h2 { font-size: 22px; }
  .cookie-policy-body h3 { font-size: 18px; }
  .cookie-policy-body h4 { font-size: 16px; }

  /* Paragraphs */
  .cookie-policy-body p {
    margin-bottom: 1em;
    font-size: 15px;
    line-height: 1.75;
  }

  /* Italic / bold */
  .cookie-policy-body em,
  .cookie-policy-body i  { font-style: italic; }
  .cookie-policy-body strong,
  .cookie-policy-body b  { font-weight: 700; }

  /* Lists */
  .cookie-policy-body ul,
  .cookie-policy-body ol {
    padding-left: 1.6em;
    margin-bottom: 1em;
  }
  .cookie-policy-body ul { list-style-type: disc; }
  .cookie-policy-body ol { list-style-type: decimal; }
  .cookie-policy-body li {
    display: list-item;
    font-size: 15px;
    line-height: 1.75;
    margin-bottom: 0.3em;
  }

  /* Tables */
  .cookie-policy-body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5em;
    font-size: 14px;
  }
  .cookie-policy-body th,
  .cookie-policy-body td {
    border: 1px solid #d4d4d4;
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
  }
  .cookie-policy-body th {
    background: #f5f5f5;
    font-weight: 700;
  }

  /* Links */
  .cookie-policy-body a {
    color: #1C1D52;
    text-decoration: underline;
  }
  .cookie-policy-body a:hover { opacity: 0.7; }
</style>

<div class="cookie-policy-body">
  {{ page.content }}
</div>

{% schema %}
{
  "name": "Cookie Policy",
  "tag": "section",
  "class": "shopify-section--cookie-policy",
  "settings": [],
  "presets": [
    { "name": "Cookie Policy" }
  ]
}
{% endschema %}
