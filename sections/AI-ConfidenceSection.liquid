{% comment %}
  AI-ConfidenceSection - Kim Gravel section with different layouts for mobile and desktop
  Desktop: Simple banner image
  Mobile: Two images stacked + text content with Amalfi Coast font
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Amalfi+Coast&display=swap');
  
  .amalfi-font {
    font-family: 'Amalfi Coast', cursive;
  }
</style>

<section class="tw-w-full tw-flex tw-justify-center">
  <div class="tw-w-full tw-max-w-[1440px]">
    
    {%- comment -%} Desktop Layout - Banner Only {%- endcomment -%}
    <div class="tw-hidden md:tw-block">
      {% if section.settings.desktop_banner != blank %}
        <img
          src="{{ section.settings.desktop_banner | image_url: width: 1440 }}"
          srcset="{{ section.settings.desktop_banner | image_url: width: 600 }} 600w,
                  {{ section.settings.desktop_banner | image_url: width: 1000 }} 1000w,
                  {{ section.settings.desktop_banner | image_url: width: 1440 }} 1440w"
          sizes="(max-width: 1440px) 100vw, 1440px"
          alt="{{ section.settings.desktop_banner.alt | escape }}"
          class="tw-w-full tw-h-auto"
          loading="lazy"
        >
      {% endif %}
    </div>

    {%- comment -%} Mobile Layout - Two Images + Text {%- endcomment -%}
    <div class="tw-block md:tw-hidden tw-px-5 tw-py-8" style="background-color: {{ section.settings.mobile_bg_color }};">
      
      {%- comment -%} Woman Photo and Name/Signature {%- endcomment -%}
      <div class="tw-mb-6">
        {%- comment -%} Woman Photo {%- endcomment -%}
        {% if section.settings.mobile_image_left != blank %}
          <div class="tw-mb-4">
            <img
              src="{{ section.settings.mobile_image_left | image_url: width: 400 }}"
              srcset="{{ section.settings.mobile_image_left | image_url: width: 200 }} 200w,
                      {{ section.settings.mobile_image_left | image_url: width: 400 }} 400w"
              sizes="100vw"
              alt="{{ section.settings.mobile_image_left.alt | escape }}"
              class="tw-w-full tw-h-auto"
              loading="lazy"
            >
          </div>
        {% endif %}

        {%- comment -%} Name and Signature Image Below Woman Photo {%- endcomment -%}
        <div class="tw-text-center">
          {% if section.settings.name != blank %}
            <p 
              class="tw-mb-2"
              style="
                font-size: clamp(18px, 5vw, 24px);
                font-weight: 700;
                letter-spacing: 0.05em;
                color: {{ section.settings.name_color }};
              "
            >
              {{ section.settings.name }}
            </p>
          {% endif %}
          
          {% if section.settings.signature_image != blank %}
            <div class="tw-flex tw-justify-center">
              <img
                src="{{ section.settings.signature_image | image_url: width: 200 }}"
                srcset="{{ section.settings.signature_image | image_url: width: 100 }} 100w,
                        {{ section.settings.signature_image | image_url: width: 200 }} 200w"
                sizes="200px"
                alt="{{ section.settings.signature_image.alt | escape }}"
                class="tw-h-auto"
                style="max-width: 150px;"
                loading="lazy"
              >
            </div>
          {% endif %}
        </div>
      </div>

      {%- comment -%} Text Content Below {%- endcomment -%}
      <div class="tw-text-center">
        {%- comment -%} Confidence Title {%- endcomment -%}
        {% if section.settings.confidence_title != blank %}
          <h2 
            class="amalfi-font tw-mb-2"
            style="
              font-size: clamp(32px, 8vw, 48px);
              line-height: 1.2;
              color: {{ section.settings.confidence_color }};
            "
          >
            {{ section.settings.confidence_title }}
          </h2>
        {% endif %}

        {%- comment -%} One Wink At A Time {%- endcomment -%}
        {% if section.settings.main_heading != blank %}
          <h3 
            class="tw-mb-3"
            style="
              font-size: clamp(20px, 5vw, 28px);
              font-weight: 700;
              line-height: 1.3;
              text-transform: uppercase;
              color: {{ section.settings.heading_color }};
            "
          >
            {{ section.settings.main_heading }}
          </h3>
        {% endif %}

        {%- comment -%} Red Divider Line {%- endcomment -%}
        <div 
          class="tw-mx-auto tw-mb-4"
          style="
            width: 100%;
            max-width: 400px;
            height: 5px;
            background-color: #D41870;
          "
        ></div>

        {%- comment -%} Description Richtext {%- endcomment -%}
        {% if section.settings.description != blank %}
          <div 
            class="tw-mx-auto"
            style="
              font-size: clamp(14px, 3.5vw, 16px);
              line-height: 1.6;
              max-width: 600px;
              color: {{ section.settings.text_color }};
            "
          >
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "AI Confidence Section",
  "settings": [
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Desktop Banner Image"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "color",
      "id": "mobile_bg_color",
      "label": "Mobile Background Color",
      "default": "#F5E6F0"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_left",
      "label": "Mobile Woman Photo"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "KIM GRAVEL"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature Image (Below Woman Photo)"
    },
    {
      "type": "text",
      "id": "confidence_title",
      "label": "Confidence Title (Amalfi Font)",
      "default": "Confidence"
    },
    {
      "type": "color",
      "id": "confidence_color",
      "label": "Confidence Title Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "ONE WINK AT A TIME"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Main Heading Color",
      "default": "#C2185B"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>I created Flash Lash for real women who want instant confidence — the kind that doesn't need filters or hours in front of a mirror.</p><p>This season, I wanted to give our VIP community something special — the chance to feel instantly glamorous, effortlessly beautiful, and fully themselves.</p><p>Whether you're gifting it or wearing it to light up the room, Flash Lash is your reminder that confidence is the best accessory.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "AI Confidence Section"
    }
  ]
}
{% endschema %}
