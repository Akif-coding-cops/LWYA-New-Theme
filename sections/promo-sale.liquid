<section id="promo-sale-event" class="tw-w-full" style="background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 0;">
  <div class="tw-mx-auto tw-px-[16px]" style="max-width: 1332px">

    <div class="tw-text-center tw-mb-[40px] md:tw-mb-[60px]">
      <div class="tw-mb-[30px]">

        {%- comment -%} Desktop View {%- endcomment -%}
        <div class="tw-hidden md:tw-block">
          
          {% if section.settings.banner_video != blank %}
            
            {{
              section.settings.banner_video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                class: 'tw-w-full'
            }}

          {% elsif section.settings.banner_image_desktop != blank %}

            <img
              src="{{ section.settings.banner_image_desktop | image_url: width: 2000 }}"
              alt="{{ section.settings.title }}"
              loading="lazy"
              class="tw-w-full tw-object-cover"
            >

          {% endif %}

        </div>

        <div class="md:tw-hidden">
          
          {% if section.settings.banner_video_mobile != blank %}

            {{
              section.settings.banner_video_mobile
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                class: 'tw-w-full'
            }}

          {% elsif section.settings.banner_image_mobile != blank %}

            <img
              src="{{ section.settings.banner_image_mobile | image_url: width: 1200 }}"
              alt="{{ section.settings.title }}"
              loading="lazy"
              class="tw-w-full tw-object-cover"
            >

          {% endif %}

        </div>

      </div>

      <div class="tw-flex tw-flex-col tw-gap-[30px]">
          <h2 class="!tw-font-didot tw-text-[28px] md:tw-text-[42px] tw-italic caption-prod-collection">
            {{ section.settings.section_title }}
          </h2>
    
          <p class="tw-uppercase tw-tracking-[0.05em] tw-text-[28px] md:tw-text-[42px]">
            {{ section.settings.section_subtitle }}
          </p>
      </div>
    </div>

    {% assign promo_collection = section.settings.collection %}

    {% if promo_collection != blank %}
        {% assign product_limit = promo_collection.products_count %}
        {% paginate promo_collection.products by product_limit %}
            {% render 'products-grid', products: promo_collection.products, settings: product_grid_settings %}
        {% endpaginate %}
    {% endif %}
  </div>
<style>

.promo-save-badge{
    position:absolute;
    top:12px;
    right:12px;
    background:#000;
    color:#fff;
    padding:6px 10px;
    font-size:14px;
    font-weight:700;
    text-transform:uppercase;
}

.sale-price{
    font-weight:700;
    font-family:"Gotham_Bold";
    font-size:17px;
}

.full-price-prod{
    color:#000;
    font-weight:700;
    font-family:"Gotham_Bold";
    font-size:17px;
}

</style>


<script>
    (function(){

    const section = document.getElementById('promo-sale-event')
    if(!section) return

    const targetStr = "{{ section.settings.target_datetime }}"
    const targetTime = new Date(targetStr.replace(' ', 'T') + ':00-05:00').getTime()

    if(isNaN(targetTime)){
    console.error("Invalid countdown date:", targetStr)
    return
    }

    function updateTimer(){

    const now = Date.now()
    let diff = targetTime - now

    if(diff <= 0) diff = 0

    const d = Math.floor(diff/(1000*60*60*24))
    const h = Math.floor((diff%(1000*60*60*24))/(1000*60*60))
    const m = Math.floor((diff%(1000*60*60))/(1000*60))
    const s = Math.floor((diff%(1000*60))/1000)

    section.querySelector('.days').textContent = String(d).padStart(2,'0')
    section.querySelector('.hours').textContent = String(h).padStart(2,'0')
    section.querySelector('.minutes').textContent = String(m).padStart(2,'0')
    section.querySelector('.seconds').textContent = String(s).padStart(2,'0')

    }

    updateTimer()
    setInterval(updateTimer,1000)

    })()

</script>

</section>


