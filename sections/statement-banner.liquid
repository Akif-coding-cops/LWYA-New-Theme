{% style %}

.statement-banner {
  background-color: {{ section.settings.background_color }};
  padding: {{ section.settings.section_padding }}px {{ section.settings.desktop_padding_sides }}rem;
}

.statement-banner__container {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.statement-banner__heading {
  font-size: {{ section.settings.desktop_font_size }}px;
  line-height: {{ section.settings.desktop_line_height }}px;
  color: {{ section.settings.text_color }};
  margin: 0;
}

.statement-banner__italic {
  font-family: 'Didot', serif;
  font-style: italic;
  font-weight: 400;
}

.statement-banner__highlight {
  font-family: 'Gotham-Book', sans-serif !important;
  font-weight: 325 !important;
  position: relative;
  display: inline-block;
}

/* AUTO WIDTH UNDERLINE */
.statement-banner__highlight::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -12px;
  width: 100%;
  height: {{ section.settings.underline_thickness }}px;
  background-color: {{ section.settings.underline_color }};
}

/* MOBILE RESPONSIVE */
@media screen and (max-width: 1400px) {

  .statement-banner {
    padding: {{ section.settings.mobile_padding }}px {{ section.settings.tablet_padding_sides }}rem;
  }

  .statement-banner__heading {
    font-size: {{ section.settings.tablet_font_size }}px;
    line-height: {{ section.settings.mobile_line_height }}px;
  }

  .statement-banner__highlight::after {
    bottom: -8px;
  }
}

@media screen and (max-width: 768px) {

  .statement-banner {
    padding: {{ section.settings.mobile_padding }}px {{ section.settings.mobile_padding_sides }}rem;
  }

  .statement-banner__heading {
    font-size: {{ section.settings.mobile_font_size }}px;
    line-height: {{ section.settings.mobile_line_height }}px;
  }

  .statement-banner__highlight::after {
    bottom: -8px;
  }
}

{% endstyle %}

<section class="statement-banner">
  <div class="statement-banner__container">
    <h2 class="statement-banner__heading" style="text-align: {{ section.settings.text_alignment }};">
      
      <span class="statement-banner__italic">
        {{ section.settings.italic_text }}
      </span>
      
      <span class="statement-banner__highlight">
        {{ section.settings.highlight_text }}
      </span>

    </h2>
  </div>
</section>

{% schema %}
{
  "name": "Statement Banner",
  "settings": [
    {
      "type": "text",
      "id": "italic_text",
      "label": "Italic Text",
      "default": "No filters. No fakes."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": " JUST YOU."
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "label": "Desktop Font Size",
      "min": 30,
      "max": 120,
      "step": 1,
      "default": 85
    },
    {
      "type": "range",
      "id": "tablet_font_size",
      "label": "Tablet Font Size",
      "min": 30,
      "max": 120,
      "step": 1,
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile Font Size",
      "min": 20,
      "max": 80,
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_line_height",
      "label": "Desktop Line Height",
      "min": 60,
      "max": 150,
      "step": 1,
      "default": 107
    },
    {
      "type": "range",
      "id": "mobile_line_height",
      "label": "Mobile Line Height",
      "min": 30,
      "max": 120,
      "step": 1,
      "default": 50
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline Thickness",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Color",
      "default": "#D41870"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container Width",
      "min": 600,
      "max": 1600,
      "step": 10,
      "default": 1260
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Desktop Top/Bottom Padding",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile Top/Bottom Padding",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding_sides",
      "label": "Desktop/Padding Sides",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "default": 5
    },
    {
      "type": "range",
      "id": "tablet_padding_sides",
      "label": "Tablet/Padding Sides",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_padding_sides",
      "label": "Mobile/Padding Sides",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Statement Banner"
    }
  ]
}
{% endschema %}
