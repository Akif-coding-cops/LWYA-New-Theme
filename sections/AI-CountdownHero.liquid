{% comment %} AI-CountdownHero.liquid {% endcomment %}

<section
  class="tw-w-full tw-flex tw-justify-center tw-items-center tw-overflow-hidden"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="tw-relative tw-w-full" style="max-width: 1440px;">
    {%- comment -%} Background Image {%- endcomment -%}
    {% if section.settings.background_image != blank %}
      <div class="tw-absolute tw-inset-0 tw-w-full tw-h-full">
        <img
          src="{{ section.settings.background_image | image_url: width: 1440 }}"
          srcset="
            {{ section.settings.background_image | image_url: width: 768 }} 768w,
            {{ section.settings.background_image | image_url: width: 1024 }} 1024w,
            {{ section.settings.background_image | image_url: width: 1440 }} 1440w
          "
          sizes="(max-width: 768px) 100vw, 1440px"
          alt="{{ section.settings.heading | escape }}"
          class="tw-w-full tw-h-full tw-object-cover"
        >
      </div>
    {% endif %}

    {%- comment -%} Content Overlay {%- endcomment -%}
    <div class="tw-relative tw-grid tw-grid-cols-1 lg:tw-grid-cols-2 tw-min-h-[500px] md:tw-min-h-[600px]">
      {%- comment -%} Left Side - Empty Space for Image Showcase {%- endcomment -%}
      <div class="tw-hidden lg:tw-block"></div>

      {%- comment -%} Right Side - Content {%- endcomment -%}
      <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-text-center tw-px-[32px] tw-py-[60px] md:tw-px-[60px] md:tw-py-[80px]">
        {%- comment -%} Heading {%- endcomment -%}
        {% if section.settings.heading != blank %}
          <h2
            class="tw-font-semibold tw-mb-4"
            style="font-size: clamp(24px, 4vw, 42px); color: {{ section.settings.heading_color }}; line-height: 1.2;"
          >
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {%- comment -%} Subheading {%- endcomment -%}
        {% if section.settings.subheading != blank %}
          <h3
            class="tw-font-semibold tw-mb-2"
            style="font-size: clamp(20px, 3.5vw, 36px); color: {{ section.settings.subheading_color }}; line-height: 1.2;"
          >
            {{ section.settings.subheading }}
          </h3>
        {% endif %}

        {%- comment -%} Tagline {%- endcomment -%}
        {% if section.settings.tagline != blank %}
          <p
            class="tw-font-bold tw-mb-8"
            style="font-size: clamp(18px, 3vw, 32px); color: {{ section.settings.tagline_color }}; line-height: 1.3;"
          >
            {{ section.settings.tagline }}
          </p>
        {% endif %}

        {%- comment -%} Countdown Timer {%- endcomment -%}
        <div class="countdown-timer tw-mb-8" data-end-date="{{ section.settings.countdown_end }}">
          <div class="tw-flex tw-gap-4 tw-justify-center tw-items-center">
            <div class="countdown-item tw-flex tw-flex-col tw-items-center">
              <div
                class="countdown-value tw-font-black tw-leading-none"
                style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
              >
                <span class="days">00</span>
              </div>
              <div
                class="countdown-label tw-uppercase tw-font-semibold tw-mt-1"
                style="font-size: clamp(12px, 1.5vw, 16px); color: {{ section.settings.countdown_color }};"
              >
                DAYS
              </div>
            </div>
            <div
              class="countdown-separator tw-font-black tw-leading-none"
              style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
            >
              :
            </div>
            <div class="countdown-item tw-flex tw-flex-col tw-items-center">
              <div
                class="countdown-value tw-font-black tw-leading-none"
                style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
              >
                <span class="hours">00</span>
              </div>
              <div
                class="countdown-label tw-uppercase tw-font-semibold tw-mt-1"
                style="font-size: clamp(12px, 1.5vw, 16px); color: {{ section.settings.countdown_color }};"
              >
                HRS
              </div>
            </div>
            <div
              class="countdown-separator tw-font-black tw-leading-none"
              style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
            >
              :
            </div>
            <div class="countdown-item tw-flex tw-flex-col tw-items-center">
              <div
                class="countdown-value tw-font-black tw-leading-none"
                style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
              >
                <span class="minutes">00</span>
              </div>
              <div
                class="countdown-label tw-uppercase tw-font-semibold tw-mt-1"
                style="font-size: clamp(12px, 1.5vw, 16px); color: {{ section.settings.countdown_color }};"
              >
                MIN
              </div>
            </div>
            <div
              class="countdown-separator tw-font-black tw-leading-none"
              style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
            >
              :
            </div>
            <div class="countdown-item tw-flex tw-flex-col tw-items-center">
              <div
                class="countdown-value tw-font-black tw-leading-none"
                style="font-size: clamp(48px, 8vw, 72px); color: {{ section.settings.countdown_color }};"
              >
                <span class="seconds">00</span>
              </div>
              <div
                class="countdown-label tw-uppercase tw-font-semibold tw-mt-1"
                style="font-size: clamp(12px, 1.5vw, 16px); color: {{ section.settings.countdown_color }};"
              >
                SEC
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Button {%- endcomment -%}
        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="tw-inline-block tw-font-bold tw-uppercase tw-rounded-md tw-transition-all tw-duration-300 hover:tw-opacity-90 hover:tw-scale-105"
            style="padding: clamp(14px, 2vw, 20px) clamp(32px, 5vw, 60px); background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }}; font-size: clamp(16px, 2vw, 22px);"
          >
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const countdownTimers = document.querySelectorAll('.countdown-timer');

    countdownTimers.forEach((timer) => {
      const endDate = timer.getAttribute('data-end-date');
      if (!endDate) return;

      const endTime = new Date(endDate).getTime();

      function updateCountdown() {
        const now = new Date().getTime();
        const distance = endTime - now;

        if (distance < 0) {
          timer.querySelector('.days').textContent = '00';
          timer.querySelector('.hours').textContent = '00';
          timer.querySelector('.minutes').textContent = '00';
          timer.querySelector('.seconds').textContent = '00';
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        timer.querySelector('.days').textContent = String(days).padStart(2, '0');
        timer.querySelector('.hours').textContent = String(hours).padStart(2, '0');
        timer.querySelector('.minutes').textContent = String(minutes).padStart(2, '0');
        timer.querySelector('.seconds').textContent = String(seconds).padStart(2, '0');
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    });
  });
</script>

{% schema %}
{
  "name": "Countdown Hero",
  "tag": "section",
  "class": "countdown-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color (fallback)",
      "default": "#FFB3D9"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Time is running out—"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "but your perfect Holiday gift?"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Just a click away."
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Countdown Timer"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "End Date & Time",
      "info": "Format: YYYY-MM-DD HH:MM:SS (e.g., 2025-12-31 23:59:59)",
      "default": "2025-12-31 23:59:59"
    },
    {
      "type": "color",
      "id": "countdown_color",
      "label": "Countdown Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get My VIP Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#C2185B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Countdown Hero"
    }
  ]
}
{% endschema %}
