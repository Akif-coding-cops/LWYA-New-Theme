{% schema %}
{
  "name": "AI New Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "text_line_1",
      "label": "Text Line 1",
      "default": "JOIN IN ON THE FUN!"
    },
    {
      "type": "text",
      "id": "text_line_2",
      "label": "Text Line 2",
      "default": "Sign up for early access & exclusives"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EDEDED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "subscribe_modal_image",
      "label": "Subscribe Modal Image"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2025 Love Who You Are, All Rights Reserved"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "SUPPORT"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AI New Footer",
      "blocks": [
        {
          "type": "menu_column",
          "settings": {
            "title": "SUPPORT"
          }
        },
        {
          "type": "menu_column",
          "settings": {
            "title": "DISCOVER"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<footer
  class="tw-w-full tw-py-[40px] md:tw-py-[60px]"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; max-width:1400px; margin-left: auto; margin-right: auto;"
>
  <div class="tw-max-w-[1440px] tw-mx-auto tw-px-[16px] md:tw-px-[24px]">
    <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-12 tw-gap-[40px] md:tw-gap-[60px]">
      <!-- Left Section: Logo + Text + Subscribe -->
      <div class="tw-col-span-1 md:tw-col-span-5 tw-flex tw-flex-col tw-gap-[20px]">
        {% if section.settings.logo %}
          <img
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            class="tw-w-[120px] tw-h-auto"
            loading="lazy"
          >
        {% endif %}

        {% if section.settings.text_line_1 != blank %}
          <p class="tw-text-[22px] md:tw-text-[32px] tw-font-normal tw-uppercase tw-leading-tight">
            {{ section.settings.text_line_1 }}
          </p>
        {% endif %}

        {% if section.settings.text_line_2 != blank %}
          <p class="tw-text-[14px] md:tw-text-[20px] tw-font-bold tw-leading-relaxed tw-mt-[-8px]">
            {{ section.settings.text_line_2 }}
          </p>
        {% endif %}

        <!-- Decorative Rectangle -->
        <div class="tw-w-[280px] md:tw-w-[350px] tw-h-[50px] tw-bg-[#D9D9D9] tw-rounded-[4px]"></div>

        <!-- Subscribe Button -->
        <button
          type="button"
          class="footer-subscribe-btn tw-w-full md:tw-w-[200px] tw-bg-black tw-text-white tw-uppercase tw-font-bold tw-text-[14px] tw-py-[12px] tw-px-[24px] hover:tw-bg-gray-800 tw-transition-colors tw-cursor-pointer"
        >
          SUBSCRIBE
        </button>
      </div>

      <!-- Right Section: Menu Columns -->
      <div class="tw-col-span-1 md:tw-col-span-7 tw-flex tw-flex-col tw-gap-[40px]">
        <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-[20px] md:tw-gap-[40px]">
          {% for block in section.blocks %}
            {% if block.type == 'menu_column' %}
              <div class="tw-flex tw-flex-col" {{ block.shopify_attributes }}>
                <!-- Mobile: Dropdown -->
                <div class="md:tw-hidden">
                  <details class="tw-group">
                    <summary class="tw-flex tw-items-center tw-justify-between tw-cursor-pointer tw-py-[12px] tw-border-b tw-border-gray-300 tw-list-none">
                      <span class="tw-font-bold tw-text-[16px] tw-uppercase">{{ block.settings.title }}</span>
                      <span class="footer-dropdown-icon tw-text-[24px] tw-font-normal tw-transition-all tw-duration-300 tw-ease-in-out"
                        >+</span
                      >
                    </summary>
                    <div class="tw-pt-[12px] tw-pb-[8px]">
                      {% if block.settings.menu != blank %}
                        <ul class="tw-flex tw-flex-col tw-gap-[8px] tw-list-none tw-p-0 tw-m-0">
                          {% for link in linklists[block.settings.menu].links %}
                            <li class="!tw-p-0 !tw-m-0">
                              <a
                                href="{{ link.url }}"
                                class="tw-text-[14px] hover:tw-underline tw-block tw-py-[4px] tw-no-underline"
                              >
                                {{ link.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  </details>
                </div>

                <!-- Desktop: Normal List -->
                <div class="tw-hidden md:tw-block">
                  <h4 class="tw-font-bold tw-text-[20px] tw-uppercase tw-mb-[12px]">{{ block.settings.title }}</h4>
                  {% if block.settings.menu != blank %}
                    <ul class="tw-flex tw-flex-col tw-gap-[8px] tw-list-none tw-p-0 tw-m-0">
                      {% for link in linklists[block.settings.menu].links %}
                        <li class="!tw-pl-0">
                          <a href="{{ link.url }}" class="tw-text-[20px] hover:tw-underline tw-no-underline">
                            {{ link.title }}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Social Media Icons + Copyright -->
        <div class="tw-flex tw-flex-col tw-gap-[16px]">
          <!-- Social Media Icons -->
          <div class="tw-flex tw-items-center tw-gap-[16px]">
            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                target="_blank"
                rel="noopener"
                class="tw-text-[24px] hover:tw-opacity-70 tw-transition-opacity"
              >
                <span class="tw-sr-only">Facebook</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                target="_blank"
                rel="noopener"
                class="tw-text-[24px] hover:tw-opacity-70 tw-transition-opacity"
              >
                <span class="tw-sr-only">Instagram</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.x_url != blank %}
              <a
                href="{{ section.settings.x_url }}"
                target="_blank"
                rel="noopener"
                class="tw-text-[24px] hover:tw-opacity-70 tw-transition-opacity"
              >
                <span class="tw-sr-only">X (Twitter)</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
              <a
                href="{{ section.settings.tiktok_url }}"
                target="_blank"
                rel="noopener"
                class="tw-text-[24px] hover:tw-opacity-70 tw-transition-opacity"
              >
                <span class="tw-sr-only">TikTok</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.youtube_url != blank %}
              <a
                href="{{ section.settings.youtube_url }}"
                target="_blank"
                rel="noopener"
                class="tw-text-[24px] hover:tw-opacity-70 tw-transition-opacity"
              >
                <span class="tw-sr-only">YouTube</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            {% endif %}
          </div>

          <!-- Copyright -->
          <div class="tw-text-[20px] tw-font-bold">
            {{ section.settings.copyright_text }}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Subscribe Modal -->
<div
  id="footer-subscribe-modal"
  class="tw-fixed tw-inset-0 tw-z-[99999] tw-hidden tw-bg-black tw-bg-opacity-50 tw-flex tw-items-center tw-justify-center"
  style="display: none;"
>
  <div class="tw-bg-white tw-max-w-[600px] tw-w-[90%] tw-max-h-[90vh] tw-overflow-hidden tw-relative tw-flex tw-flex-col md:tw-flex-row">
    <!-- Close Button -->
    <button
      type="button"
      class="footer-modal-close tw-absolute tw-top-4 tw-right-4 tw-text-gray-500 hover:tw-text-gray-700 tw-text-2xl tw-leading-none tw-w-8 tw-h-8 tw-flex tw-items-center tw-justify-center tw-cursor-pointer tw-z-10"
    >
      &times;
    </button>

    <!-- Left: Image -->
    {% if section.settings.subscribe_modal_image %}
      <div class="tw-hidden md:tw-block md:tw-w-[40%] tw-bg-gray-200">
        <img
          src="{{ section.settings.subscribe_modal_image | image_url: width: 400 }}"
          alt="Subscribe"
          class="tw-w-full tw-h-full tw-object-cover"
          loading="lazy"
        >
      </div>
    {% endif %}

    <!-- Right: Form -->
    <div class="tw-flex-1 tw-p-[32px] md:tw-p-[40px] tw-flex tw-flex-col tw-justify-center">
      <h3 class="tw-text-[24px] md:tw-text-[28px] tw-font-bold tw-mb-[8px] tw-uppercase">Subscribe</h3>
      <p class="tw-text-[14px] tw-text-gray-600 tw-mb-[24px]">Get exclusive offers and updates!</p>

      <form class="footer-subscribe-form tw-flex tw-flex-col tw-gap-[16px]">
        <input
          type="email"
          name="email"
          placeholder="Enter your email"
          required
          class="tw-w-full tw-px-[16px] tw-py-[12px] tw-border tw-border-gray-300 tw-rounded-[4px] tw-text-[14px] focus:tw-outline-none focus:tw-border-black"
        >
        <button
          type="submit"
          class="tw-w-full tw-bg-black tw-text-white tw-uppercase tw-font-bold tw-text-[14px] tw-py-[12px] tw-px-[24px] hover:tw-bg-gray-800 tw-transition-colors"
        >
          Subscribe
        </button>
      </form>

      <div class="footer-subscribe-message tw-mt-[16px] tw-text-[14px] tw-hidden"></div>
    </div>
  </div>
</div>

<style>
  #footer-subscribe-modal {
    backdrop-filter: blur(4px);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('footer-subscribe-modal');
    const openBtn = document.querySelector('.footer-subscribe-btn');
    const closeBtn = document.querySelector('.footer-modal-close');
    const form = document.querySelector('.footer-subscribe-form');
    const messageDiv = document.querySelector('.footer-subscribe-message');

    if (!modal || !openBtn || !closeBtn || !form) return;

    // Open modal
    openBtn.addEventListener('click', () => {
      modal.style.display = 'flex';
      modal.classList.remove('tw-hidden');
      document.body.style.overflow = 'hidden';
    });

    // Close modal
    function closeModal() {
      modal.style.display = 'none';
      modal.classList.add('tw-hidden');
      document.body.style.overflow = '';
      messageDiv.classList.add('tw-hidden');
      form.reset();
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Handle form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = form.querySelector('input[name="email"]').value;

      try {
        // Subscribe to Shopify newsletter
        const response = await fetch('/contact#newsletter', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: `form_type=customer&utf8=✓&contact[email]=${encodeURIComponent(email)}&contact[tags]=newsletter`,
        });

        messageDiv.textContent = 'Thanks for subscribing!';
        messageDiv.className = 'footer-subscribe-message tw-mt-[16px] tw-text-[14px] tw-text-green-600';
        messageDiv.classList.remove('tw-hidden');

        setTimeout(() => {
          closeModal();
        }, 2000);
      } catch (error) {
        messageDiv.textContent = 'Something went wrong. Please try again.';
        messageDiv.className = 'footer-subscribe-message tw-mt-[16px] tw-text-[14px] tw-text-red-600';
        messageDiv.classList.remove('tw-hidden');
      }
    });

    // ESC key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display === 'flex') {
        closeModal();
      }
    });

    // Handle dropdown icon toggle
    const detailsElements = document.querySelectorAll('footer details');
    detailsElements.forEach((details) => {
      const icon = details.querySelector('.footer-dropdown-icon');
      if (!icon) return;

      details.addEventListener('toggle', () => {
        if (details.open) {
          // Rotate 90deg first, then change to minus
          icon.style.transform = 'rotate(90deg)';
          setTimeout(() => {
            icon.textContent = '−'; // Minus sign
            icon.style.transform = 'rotate(0deg)';
          }, 150); // Half of transition duration
        } else {
          // Rotate -90deg first, then change to plus
          icon.style.transform = 'rotate(-90deg)';
          setTimeout(() => {
            icon.textContent = '+'; // Plus sign
            icon.style.transform = 'rotate(0deg)';
          }, 150); // Half of transition duration
        }
      });
    });
  });
</script>
