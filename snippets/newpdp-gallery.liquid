{% assign media_items = product.media %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variant_media_list = current_variant.metafields.custom.variant_media.value
  assign using_variant_media = false

  assign is_bestseller = false
  for col in product.collections
    if col.handle == 'bestsellers'
      assign is_bestseller = true
      break
    endif
  endfor

  assign _compare_price = current_variant.compare_at_price | default: 0
  assign on_sale = false
  if _compare_price > current_variant.price and _compare_price > 0
    assign on_sale = true
  endif

  assign badge = product.metafields.custom.product_badge.value
  assign variant_badge = current_variant.metafields.custom.variant_badge.value

  if variant_media_list != blank and variant_media_list.size > 0
    assign using_variant_media = true
    assign img1 = null
    assign img2 = null
    assign img3 = null
    for vm in variant_media_list
      if forloop.index0 == 0
        assign img1 = vm
      endif
      if forloop.index0 == 1
        assign img2 = vm
      endif
      if forloop.index0 == 2
        assign img3 = vm
      endif
    endfor
  else
    assign variant_featured = current_variant.featured_media
    if variant_featured != blank
      assign img1 = variant_featured
    else
      assign img1 = media_items[0]
    endif
    assign img2 = media_items[1]
    assign img3 = media_items[2]
  endif
-%}

{%- comment -%}Build variant to image mapping{%- endcomment -%}
{% assign variant_images = '' %}
{% for variant in product.variants %}
  {% if variant.featured_image %}
    {% assign variant_images = variant_images
      | append: variant.id
      | append: ':'
      | append: variant.featured_image.id
      | append: ','
    %}
  {% endif %}
{% endfor %}

<div class="md:tw-hidden tw-relative tw-px-[8px]" data-mobile-gallery data-variant-images="{{ variant_images }}">
  <link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}">
  <div class="swiper newpdp-mobile-gallery">
    <div class="swiper-wrapper">
      {% for media in media_items %}
        <div class="swiper-slide" data-slide-image-id="{{ media.id }}">
          {% if media.media_type == 'image' %}
            <a href="{{ media | image_url: width: 2000 }}" class="glightbox ..." data-gallery="product-gallery">
              <img
                src="{{ media | image_url: width: 1200 }}"
                srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
                sizes="100vw"
                alt="{{ media.alt | escape }}"
                loading="lazy"
                class="tw-w-full tw-h-full tw-object-cover tw-block"
              >
            </a>
          {% elsif media.media_type == 'video' %}
            {{ media | video_tag: autoplay: true, loop: true, muted: true, class: 'tw-w-full tw-h-full' }}
          {% elsif media.media_type == 'external_video' %}
            {{ media | external_video_tag }}
          {% endif %}
        </div>
      {% endfor %}
      {% if images.size == 0 %}
        <div class="swiper-slide">
          <div class="tw-aspect-[4/5] tw-w-full tw-rounded-[8px] tw-bg-[#eee]"></div>
        </div>
      {% endif %}
    </div>
  </div>
  {% comment %}
    {% if show_best_seller_badge and product.tags contains 'best-seller' %}
      <div class="tw-absolute tw-top-[12px] tw-right-[12px] tw-bg-black tw-text-white tw-text-[12px] tw-leading-[1] tw-py-[6px] tw-px-[10px] tw-rounded-[3px] tw-z-10">
        BEST SELLER
      </div>
    {% endif %}
  {% endcomment %}

  {% comment %}
    {% if badge.type == 'best-seller' %}
      {% render 'best-seller-badge', position: 'top-right' %}
    {% elsif badge.type == 'discount' %}
      {% render 'discount-badge', product: product, show_badge: true %}
    {% endif %}
  {% endcomment %}

  {% if badge != blank %}
    {% render 'badge', position: 'top-right', text: badge.text, bg_color: badge.background_color %}
  {% elsif variant_badge != blank %}
    {% render 'badge', position: 'top-right', text: variant_badge.text, bg_color: variant_badge.background_color %}
  {% endif %}

  {% comment %}
    {% if on_sale %}
      {% render 'discount-badge', product: product %}
    {% elsif is_bestseller %}
      {% render 'best-seller-badge', position: 'top-right' %}
    {% endif %}
  {% endcomment %}
</div>

<div class="tw-hidden md:tw-block" data-main-gallery data-variant-images="{{ variant_images }}">
  {% if img1 %}
    <div class="tw-grid tw-grid-cols-3 tw-gap-[8px] tw-mb-[8px]">
      {%- comment -%} Left column: img2 + img3 {%- endcomment -%}
      <div class="tw-flex tw-flex-col tw-gap-[8px]">
        {% if img2 %}
          {% if img2.media_type == 'image' %}
            <a
              href="{{ img2 | image_url: width: 2000 }}"
              data-gallery-slot-link="2"
              class="glightbox tw-overflow-hidden tw-bg-white tw-cursor-zoom-in tw-relative tw-group tw-block"
              data-gallery="product-gallery"
            >
              <img
                data-gallery-slot="2"
                data-image-id="{{ img2.id }}"
                data-default-id="{{ media_items[1].id }}"
                data-default-src="{{ media_items[1] | image_url: width: 1600 }}"
                data-default-alt="{{ media_items[1].alt | escape }}"
                src="{{ img2 | image_url: width: 900 }}"
                srcset="{{ img2 | image_url: width: 600 }} 600w, {{ img2 | image_url: width: 900 }} 900w"
                sizes="(min-width:1024px) 33vw, 100vw"
                alt="{{ img2.alt | escape }}"
                loading="lazy"
                class="tw-w-full tw-h-full tw-object-contain"
              >
            </a>
          {% elsif img2.media_type == 'video' %}
            <div data-gallery-slot-link="2" data-gallery-slot-video="2">
              {{ img2 | video_tag: autoplay: true, loop: true, muted: true, class: 'tw-w-full tw-h-full' }}
            </div>
          {% elsif img2.media_type == 'external_video' %}
            <div data-gallery-slot-link="2" data-gallery-slot-video="2">
              {{ img2 | external_video_tag }}
            </div>
          {% endif %}
        {% endif %}

        {% if img3 %}
          {%- assign disable_ratio = false -%}
          {%- if img3.alt contains 'no-ratio' -%}{%- assign disable_ratio = true -%}{%- endif -%}
          {% if img3.media_type == 'image' %}
            <a
              href="{{ img3 | image_url: width: 2000 }}"
              data-gallery-slot-link="3"
              class="glightbox {% unless disable_ratio %}tw-aspect-square{% endunless %} tw-overflow-hidden tw-bg-white tw-cursor-zoom-in tw-relative tw-group tw-block"
              data-gallery="product-gallery"
            >
              <img
                data-gallery-slot="3"
                data-image-id="{{ img3.id }}"
                data-default-id="{{ media_items[2].id }}"
                data-default-src="{{ media_items[2] | image_url: width: 1600 }}"
                data-default-alt="{{ media_items[2].alt | escape }}"
                src="{{ img3 | image_url: width: 900 }}"
                srcset="{{ img3 | image_url: width: 600 }} 600w, {{ img3 | image_url: width: 900 }} 900w"
                sizes="(min-width:1024px) 33vw, 100vw"
                alt="{{ img3.alt | escape }}"
                loading="lazy"
                class="tw-w-full tw-h-full tw-object-contain"
              >
            </a>
          {% elsif img3.media_type == 'video' %}
            <div data-gallery-slot-link="3" data-gallery-slot-video="3">
              {{ img3 | video_tag: autoplay: true, loop: true, muted: true, class: 'tw-w-full tw-h-full' }}
            </div>
          {% elsif img3.media_type == 'external_video' %}
            <div data-gallery-slot-link="3" data-gallery-slot-video="3">
              {{ img3 | external_video_tag }}
            </div>
          {% endif %}
        {% endif %}
      </div>

      {%- comment -%} Right: Main image slot 1 {%- endcomment -%}
      {%- assign disable_ratio = false -%}
      {%- if img1.alt contains 'no-ratio' -%}{%- assign disable_ratio = true -%}{%- endif -%}
      {% if img1.media_type == 'image' %}
        <a
          href="{{ img1 | image_url: width: 2000 }}"
          data-main-image-link
          data-gallery-slot-link="1"
          class="glightbox tw-col-span-2 {% unless disable_ratio %}tw-aspect-square{% endunless %} tw-overflow-hidden tw-bg-white tw-cursor-zoom-in tw-relative tw-group tw-block"
          data-gallery="product-gallery"
        >
          <img
            data-main-image-1
            data-gallery-slot="1"
            data-image-id="{{ img1.id }}"
            data-default-id="{{ media_items[0].id }}"
            data-default-src="{{ media_items[0] | image_url: width: 1600 }}"
            data-default-alt="{{ media_items[0].alt | escape }}"
            src="{{ img1 | image_url: width: 1400 }}"
            srcset="{{ img1 | image_url: width: 900 }} 900w, {{ img1 | image_url: width: 1200 }} 1200w, {{ img1 | image_url: width: 1600 }} 1600w"
            sizes="(min-width:1024px) 66vw, 100vw"
            alt="{{ img1.alt | escape }}"
            loading="eager"
            class="tw-w-full tw-h-full tw-object-contain"
          >
          {% comment %}
            {% if show_best_seller_badge and product.tags contains 'best-seller' %}
              <div class="tw-absolute tw-top-[12px] tw-right-[12px] tw-bg-black tw-text-white tw-text-[12px] tw-leading-[1] tw-py-[6px] tw-px-[10px] tw-rounded-[3px] tw-pointer-events-none">
                BEST SELLER
              </div>
            {% endif %}
          {% endcomment %}

          {% comment %}
            {% if badge.type == 'best-seller' %}
              {% render 'best-seller-badge', position: 'top-right' %}
            {% elsif badge.type == 'discount' %}
              {% render 'discount-badge', product: product, show_badge: true %}
            {% endif %}
          {% endcomment %}

          {% if badge != blank %}
            {% render 'badge', position: 'top-right', text: badge.text, bg_color: badge.background_color %}
          {% elsif variant_badge != blank %}
            {% render 'badge',
              position: 'top-right',
              text: variant_badge.text,
              bg_color: variant_badge.background_color
            %}
          {% endif %}

          {% comment %}
            {% if on_sale %}
              {% render 'discount-badge', product: product %}
            {% elsif is_bestseller %}
              {% render 'best-seller-badge', position: 'top-right' %}
            {% endif %}
          {% endcomment %}
        </a>
      {% elsif img1.media_type == 'video' %}
        <div
          data-gallery-slot-link="1"
          data-gallery-slot-video="1"
          class="tw-col-span-2 {% unless disable_ratio %}tw-aspect-square{% endunless %} tw-overflow-hidden tw-bg-white"
        >
          {{ img1 | video_tag: autoplay: true, loop: true, muted: true, class: 'tw-w-full tw-h-full' }}
        </div>
      {% elsif img1.media_type == 'external_video' %}
        <div
          data-gallery-slot-link="1"
          data-gallery-slot-video="1"
          class="tw-col-span-2 {% unless disable_ratio %}tw-aspect-square{% endunless %} tw-overflow-hidden tw-bg-white"
        >
          {{ img1 | external_video_tag }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} Images 4+ {%- endcomment -%}
  {%- if variant_media_list != blank -%}
    {%- assign extra_media = variant_media_list -%}
  {%- else -%}
    {%- assign extra_media = media_items -%}
  {%- endif -%}

  {% if extra_media.size > 3 %}
    {% for media in extra_media offset: 3 %}
      {%- assign disable_ratio = false -%}
      {%- if media.alt contains 'no-ratio' -%}{%- assign disable_ratio = true -%}{%- endif -%}
      {% if media.media_type == 'image' %}
        <a
          href="{{ media | image_url: width: 2000 }}"
          class="glightbox {% unless disable_ratio %}tw-aspect-square{% endunless %} tw-overflow-hidden tw-bg-white tw-mb-[8px] tw-cursor-zoom-in tw-relative tw-group tw-block"
          data-gallery="product-gallery"
        >
          <img
            data-image-id="{{ media.id }}"
            src="{{ media | image_url: width: 1600 }}"
            srcset="{{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1400 }} 1400w, {{ media | image_url: width: 1800 }} 1800w"
            sizes="(min-width:1024px) 100vw, 100vw"
            alt="{{ media.alt | escape }}"
            loading="lazy"
            class="tw-w-full tw-h-full tw-object-contain"
          >
        </a>
      {% elsif media.media_type == 'video' %}
        {{ media | video_tag: autoplay: true, loop: true, muted: true, class: 'tw-w-full tw-mb-[8px]' }}
      {% elsif media.media_type == 'external_video' %}
        {{ media | external_video_tag }}
      {% endif %}
    {% endfor %}
  {% endif %}
</div>
