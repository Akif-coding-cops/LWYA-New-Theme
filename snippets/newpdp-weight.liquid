{%- liquid
  assign product_weight = product.metafields.custom.weight
-%}

{%- if product_weight != blank -%}
  <div class="tw-font-gotham-book tw-pt-[8px] tw-text-[20px] tw-leading-[20px] tw-text-[#000000]">
    {%- assign weight_lines = product_weight | split: '<br/>' -%}
    {%- for line in weight_lines -%}
      {%- unless line == blank -%}
         <p class="product-weight">{{ line }}</p>
      {%- endunless -%}
    {%- endfor -%}
  </div>
{%- endif -%}

<style>
  .product-weight {
    line-height: 26px;
  }

</style>