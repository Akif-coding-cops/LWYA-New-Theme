{% comment %}
  Reusable hover tooltip for color swatches.
  Props:
    tooltip_text — label to display on hover (required)
  Usage:
    {%- render 'lwya-swatch-tooltip', tooltip_text: swatch_name -%}
  The parent element must have class "tw-group" and "tw-relative".
{% endcomment %}

{%- unless lwya_swatch_tooltip_css_rendered -%}
  {%- assign lwya_swatch_tooltip_css_rendered = true -%}
  <style>
    .swatch-tooltip {
      opacity: 0;
      pointer-events: none;
      position: absolute;
      bottom: calc(100% + 5px);
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      font-size: 14px;
      line-height: 1;
      background: #1a1a1a;
      color: #fff;
      padding: 6px 8px;
      border-radius: 4px;
      transition: opacity 0.15s ease;
      z-index: 20;
    }
    .tw-group:hover .swatch-tooltip {
      opacity: 1;
    }
  </style>
{%- endunless -%}

<div class="swatch-tooltip" aria-hidden="true">{{ tooltip_text | escape }}</div>
