{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  
  assign variant_disabled_raw = current_variant.metafields.custom.disable_variant | default: false
  assign vd_str = variant_disabled_raw | downcase | strip
  assign variant_disabled = false
  if variant_disabled_raw == true or vd_str == 'true' or vd_str == '1'
    assign variant_disabled = true
  endif
-%}

<form method="post" action="/cart/add" id="lwya-newpdp-form" class="tw-space-y-[16px]" data-product-id="{{ product.id }}">
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
  <input type="hidden" name="quantity" value="1">

  <div
    data-unavailable-msg
    class="tw-bg-[#f5f5f5] tw-border tw-border-[#d8d8d8] tw-px-[16px] tw-py-[12px] tw-text-center tw-text-[14px] tw-text-[#6b6b6b]"
    {% unless variant_disabled %}style="display:none"{% endunless %}>
    This variant is currently unavailable
  </div>

  <div
    data-atc-wrapper
    class="tw-flex"
    {% if variant_disabled %}style="display:none"{% endif %}>
    <button 
      type="submit" 
      class="tw-flex-1 md:tw-w-[228px] md:tw-flex-initial tw-h-[41px] tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-text-[13px] md:tw-text-[18px] tw-font-metric-medium tw-uppercase tw-transition-colors tw-flex-shrink-0 tw-flex tw-justify-center tw-items-center"
      {% unless current_variant.available %}disabled{% endunless %}>
      {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
    </button>
  </div>

</form>

<script type="application/json" id="lwya-product-variants">
  {
    "title": {{ product.title | json }},
    "default_ingredient_image": {% if product.metafields.custom.ingredients_image != blank %}{{ product.metafields.custom.ingredients_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
    "variants": [
      {% for v in product.variants %}
        {%- liquid
          assign variant_disabled = false
          if v.metafields.custom.disable_variant != blank
            assign variant_disabled_raw = v.metafields.custom.disable_variant
            assign vd_str = variant_disabled_raw | downcase | strip
            if variant_disabled_raw == true or vd_str == 'true' or vd_str == '1' or vd_str == 'yes'
              assign variant_disabled = true
            endif
          endif
        -%}
        {
          "id": {{ v.id }},
          "available": {{ v.available | json }},
          "disabled": {{ variant_disabled | json }},
          "price": {{ v.price }},
          "compare_at_price": {{ v.compare_at_price | default: 0 }},
          "variant_title": {{ v.metafields.custom.variant_title | json }},
          "variant_ingredient_image": {% if v.metafields.custom.variant_ingredient_image != blank %}{{ v.metafields.custom.variant_ingredient_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
          {% if v.metafields.custom.variant_media != blank %}
            "variant_media": [
              {%- assign vm_list = v.metafields.custom.variant_media.value -%}
              {% for vm in vm_list %}
                {
                  "id": {{ vm.id }},
                  "src": {{ vm | image_url: width: 1600 | json }},
                  "alt": {{ vm.alt | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
          {% endif %}
          {% if v.featured_image %}
            "featured_image": {
              "id": {{ v.featured_image.id }},
              "src": {{ v.featured_image.src | image_url: width: 1600 | json }},
              "alt": {{ v.featured_image.alt | json }}
            },
          {% endif %}
          "options": [
            {% for o in v.options %}
              {{ o | json }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "options": [
      {% for opt in product.options %}
        {{ opt | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>