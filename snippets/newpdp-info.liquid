{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  
  assign variant_disabled_raw = current_variant.metafields.custom.disable_variant | default: false
  assign vd_str = variant_disabled_raw | downcase | strip
  assign variant_disabled = false
  if variant_disabled_raw == true or vd_str == 'true' or vd_str == '1'
    assign variant_disabled = true
  endif
-%}

<div class="tw-space-y-[16px]">
  <h1 class="tw-text-[28px] tw-leading-[34px] tw-font-metric-medium">{{ product.title }}</h1>

  <div class="tw-text-[24px] tw-leading-[28px] tw-font-metric-medium tw-text-[#d41870]" data-product-price>
    {{ current_variant.price | money }}
    {%- if current_variant.compare_at_price > current_variant.price -%}
      <s class="tw-text-[18px] tw-text-[#9b9b9b] tw-ml-[8px]">{{ current_variant.compare_at_price | money }}</s>
    {%- endif -%}
  </div>

{% if show_loox_rating %}
   <div class="loox-rating" data-id="{{ product.id }}"></div> 
  {% endif %} 

  {% if enable_recharge and variant_disabled == false %}
    <div id="lwya-recharge-slot">
      <script type="module" src="https://static.rechargecdn.com/assets/subscription-widget/subscription-widget.js"></script>
      <recharge-subscription-widget id="lwya-recharge-widget" product-id="{{ product.id }}" default-variant-id="{{ current_variant.id }}"></recharge-subscription-widget>
    </div>
  {% endif %}

  <form method="post" action="/cart/add" id="lwya-newpdp-form" class="tw-space-y-[16px]" data-product-id="{{ product.id }}">
    {% if product.has_only_default_variant == false %}
      {%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
      {%- assign swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />' -%}
      
      {% for option in product.options_with_values %}
        {%- assign option_downcase = option.name | downcase -%}
        {%- assign is_color = false -%}
        {% for color_label in color_label_list %}
          {% if option_downcase == color_label %}
            {%- assign is_color = true -%}
            {% break %}
          {% endif %}
        {% endfor %}

        <div>
          <div class="tw-text-[13px] tw-leading-[16px] tw-font-metric-medium tw-mb-[8px]">
            {{ option.name }}: <span class="tw-font-normal" data-selected-option-{{ forloop.index0 }}>{{ option.selected_value }}</span>
          </div>
          
          {% if is_color %}
            <div class="tw-flex tw-flex-wrap tw-gap-[8px]">
              {% for value in option.values %}
                {%- assign downcase_value = value | downcase | strip -%}
                {%- assign swatch_style = '--swatch-background: linear-gradient(to right, ' | append: downcase_value | append: ', ' | append: downcase_value | append: ')' -%}
                
                {%- comment -%}Parse swatch config for custom colors{%- endcomment -%}
                {% for swatch_item in swatch_config %}
                  {%- assign swatch_parts = swatch_item | split: ':' -%}
                  {%- assign swatch_name = swatch_parts.first | downcase | strip -%}
                  
                  {% if downcase_value == swatch_name %}
                    {%- assign swatch_value = swatch_parts.last | strip -%}
                    
                    {% if swatch_value contains '#' %}
                      {%- assign swatch_style = '--swatch-background: linear-gradient(to right, ' | append: swatch_value | append: ', ' | append: swatch_value | append: ')' -%}
                    {% elsif swatch_value contains 'linear-gradient(' %}
                      {%- assign swatch_style = '--swatch-background: ' | append: swatch_value -%}
                    {% elsif images[swatch_value] != blank %}
                      {%- assign swatch_image = images[swatch_value] | image_url: width: 72 -%}
                      {%- assign swatch_style = '--swatch-background: url(' | append: swatch_image | append: ')' -%}
                    {% endif %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                
                <label class="tw-relative tw-cursor-pointer tw-group">
                  <input 
                    type="radio" 
                    name="options[{{ option.name | escape }}]" 
                    value="{{ value | escape }}" 
                    class="peer tw-sr-only" 
                    data-option-position="{{ option.position }}"
                    data-variant-option="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}>
                  <span 
                    class="tw-block tw-w-[32px] tw-h-[32px] tw-rounded-full tw-border-[2px] tw-border-transparent peer-checked:tw-border-[#d41870] tw-transition-all tw-duration-200" 
                    style="background: content-box {{ swatch_style | split: ': ' | last }} no-repeat center / cover; padding: 2px;"
                    title="{{ value | escape }}"></span>
                </label>
              {% endfor %}
            </div>
          {% else %}
            <select 
              name="options[{{ option.name | escape }}]" 
              class="tw-w-full tw-border tw-border-[#d8d8d8] tw-h-[40px] tw-px-[12px] tw-text-[14px]"
              data-option-position="{{ option.position }}">
              {% for value in option.values %}
                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
              {% endfor %}
            </select>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}

    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

    {%- if variant_disabled -%}
      <div class="tw-bg-[#f5f5f5] tw-border tw-border-[#d8d8d8] tw-px-[16px] tw-py-[12px] tw-text-center tw-text-[14px] tw-text-[#6b6b6b]">
        This variant is currently unavailable
      </div>
    {%- else -%}
      <div class="tw-flex tw-items-stretch tw-gap-[6px] md:tw-gap-[8px]">
        <div class="tw-flex tw-items-center tw-border tw-border-[#d41870] tw-w-[70px] md:tw-w-[90px] tw-h-[38px] md:tw-h-[44px] tw-flex-shrink-0">
          <button type="button" class="tw-text-[#d41870] tw-w-[20px] md:tw-w-[26px] tw-h-full tw-flex tw-items-center tw-justify-center tw-text-[14px] md:tw-text-[16px] tw-text-[#6b6b6b] hover:tw-text-black tw-transition-colors tw-flex-shrink-0" data-qty-dec aria-label="Decrease quantity">−</button>
          <input 
            name="quantity" 
            value="1" 
            class="tw-text-[#d41870] tw-w-[30px] md:tw-w-[38px] tw-h-full tw-text-center tw-border-0 tw-text-[13px] md:tw-text-[14px] tw-font-metric-medium tw-outline-none tw-flex-shrink-0" 
            inputmode="numeric"
            pattern="[0-9]*"
            min="1">
          <button type="button" class="tw-text-[#d41870] tw-w-[20px] md:tw-w-[26px] tw-h-full tw-flex tw-items-center tw-justify-center tw-text-[14px] md:tw-text-[16px] tw-text-[#6b6b6b] hover:tw-text-black tw-transition-colors tw-flex-shrink-0" data-qty-inc aria-label="Increase quantity">+</button>
        </div>
        <button 
          type="submit" 
          class="tw-flex-1 md:tw-w-[250px] md:tw-flex-initial tw-h-[38px] md:tw-h-[44px] tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-text-[13px] md:tw-text-[14px] tw-font-metric-medium tw-uppercase tw-transition-colors tw-flex-shrink-0"
          {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>
      </div>
    {%- endif -%}
  </form>
</div>

<script type="application/json" id="lwya-product-variants">
  {
    "variants": [
      {% for v in product.variants %}
        {
          "id": {{ v.id }},
          "available": {{ v.available | json }},
          "price": {{ v.price }},
          "compare_at_price": {{ v.compare_at_price | default: 0 }},
          {% if v.featured_image %}
            "featured_image": {
              "id": {{ v.featured_image.id }},
              "src": {{ v.featured_image.src | image_url: width: 1600 | json }},
              "alt": {{ v.featured_image.alt | json }}
            },
          {% endif %}
          "options": [
            {% for o in v.options %}
              {{ o | json }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "options": [
      {% for opt in product.options %}
        {{ opt | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>