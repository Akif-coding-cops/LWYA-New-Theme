{%- liquid
  assign current_variant      = product.selected_or_first_available_variant
  assign variant_videos       = current_variant.metafields.custom.variant_videos.value
  assign using_variant_videos = false
  assign videos_list          = nil

  if variant_videos != blank and variant_videos.size > 0
    assign using_variant_videos = true
    assign videos_list          = variant_videos
  else
    assign videos_metafield_key = block.settings.videos_metafield_key
    assign key_parts            = videos_metafield_key | split: '.'
    assign ns                   = key_parts.first
    assign k                    = key_parts.last
    assign videos_value         = product.metafields[ns][k]
    if videos_value != blank and videos_value.value.size > 0
      assign videos_list = videos_value.value
    endif
  endif
-%}

<script>
  console.log('🎬 Variant Videos Debug:');
  console.log('using_variant_videos:', {{ using_variant_videos | json }});
  {% if variant_videos != blank %}
    console.log('variant_videos size:', {{ variant_videos.size }});
    {% for v in variant_videos %}
      console.log('variant video {{ forloop.index }}:', {
        id: '{{ v.id }}',
        url: '{{ v | file_url }}',
        media_type: '{{ v.media_type }}',
        content_type: '{{ v.content_type }}'
      });
    {% endfor %}
  {% else %}
    console.log('variant_videos is blank');
  {% endif %}
</script>

<script>
  console.log('🎬 Videos Debug Info:');
  console.log('Using variant videos:', {{ using_variant_videos | json }});
  {% if using_variant_videos %}
    console.log('Variant videos count:', {{ variant_videos.size | default: 0 }});
  {% else %}
    console.log('Metafield Key:', '{{ block.settings.videos_metafield_key }}');
    {% if videos_value != blank %}
      console.log('Has product videos: YES');
      console.log('Videos count:', {{ videos_value.value.size | default: 0 }});
      {% for v in videos_value.value %}
        console.log('Video {{ forloop.index }}:', {
          id: {{ v.id }},
          aspect_ratio: {{ v.aspect_ratio }},
          duration: {{ v.duration | default: 0 }},
          sources: [
            {% for source in v.sources %}
              {
                url: '{{ source.url }}',
                format: '{{ source.format }}',
                mime_type: '{{ source.mime_type }}',
                width: {{ source.width }},
                height: {{ source.height }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        });
      {% endfor %}
    {% else %}
      console.log('Has product videos: NO');
    {% endif %}
  {% endif %}
</script>

{% if videos_list != blank and videos_list.size > 0 %}
  <div class="tw-my-[60px] lwya-videos-block" {{ block.shopify_attributes }}>
    <div class="tw-py-[20px] tw-border-t tw-border-[#000000] tw-text-[18px] tw-font-[700] tw-leading-none tw-mb-0 video-title">
      OUR PRODUCTS IN ACTION
    </div>

    <div class="tw-relative tw-px-[8px] md:tw-px-0">
      <div class="swiper lwya-videos-swiper">
        <div class="swiper-wrapper">
          {% for v in videos_list %}
            <div class="swiper-slide">
              <div class="tw-w-full tw-aspect-[2/3] tw-rounded-[8px] tw-overflow-hidden tw-bg-[#f6f6f6] tw-group">
                <video
                  preload="metadata"
                  class="tw-w-full tw-h-full tw-object-cover lwya-hover-video"
                  playsinline
                  autoplay
                  loop
                  muted
                >
                  {%- comment -%} Both variant and product videos use .sources {%- endcomment -%}
                  {% for source in v.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {%- comment -%} Prev Arrow {%- endcomment -%}
      <div class="lwya-videos-prev tw-absolute tw-left-[-8px] md:tw-left-[-24px] tw-top-[50%] tw-translate-y-[-50%] tw-w-[21px] tw-h-[21px] tw-bg-black tw-rounded-full tw-flex tw-items-center tw-justify-center tw-cursor-pointer tw-z-[3] hover:tw-opacity-80 tw-transition-all tw-opacity-0 tw-pointer-events-none">
        <svg class="tw-w-[12px] tw-h-[12px] tw-text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </div>

      {%- comment -%} Next Arrow {%- endcomment -%}
      <div class="lwya-videos-next tw-absolute tw-right-[-8px] md:tw-right-[-24px] tw-top-[50%] tw-translate-y-[-50%] tw-w-[21px] tw-h-[21px] tw-bg-black tw-rounded-full tw-flex tw-items-center tw-justify-center tw-cursor-pointer tw-z-[3] hover:tw-opacity-80 tw-transition-all">
        <svg class="tw-w-[12px] tw-h-[12px] tw-text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof Swiper === 'undefined') return;

      const prevButton = document.querySelector('.lwya-videos-prev');
      const nextButton = document.querySelector('.lwya-videos-next');

      const videosSwiper = new Swiper('.lwya-videos-swiper', {
        slidesPerView: 3,
        spaceBetween: 12,
        navigation: {
          nextEl: '.lwya-videos-next',
          prevEl: '.lwya-videos-prev',
        },
        breakpoints: {
          0:    { slidesPerView: 1.3, spaceBetween: 12 },
          480:  { slidesPerView: 2,   spaceBetween: 12 },
          640:  { slidesPerView: 2.5, spaceBetween: 12 },
          1024: { slidesPerView: 3,   spaceBetween: 12 }
        },
        on: {
          init:           function() { updateArrowVisibility(this); },
          slideChange:    function() { updateArrowVisibility(this); },
          reachBeginning: function() { updateArrowVisibility(this); },
          reachEnd:       function() { updateArrowVisibility(this); }
        }
      });

      function updateArrowVisibility(swiper) {
        if (prevButton) {
          prevButton.classList.toggle('tw-opacity-0',           swiper.isBeginning);
          prevButton.classList.toggle('tw-pointer-events-none', swiper.isBeginning);
          prevButton.classList.toggle('tw-opacity-100',         !swiper.isBeginning);
        }
        if (nextButton) {
          nextButton.classList.toggle('tw-opacity-0',           swiper.isEnd);
          nextButton.classList.toggle('tw-pointer-events-none', swiper.isEnd);
          nextButton.classList.toggle('tw-opacity-100',         !swiper.isEnd);
        }
      }

      console.log('✅ Videos Swiper initialized');

      // Show controls on hover
      document.querySelectorAll('.lwya-hover-video').forEach(video => {
        video.addEventListener('mouseenter', () => video.setAttribute('controls', 'controls'));
        video.addEventListener('mouseleave', () => video.removeAttribute('controls'));
      });
    });
  </script>

{% else %}
  <script>
    console.log('❌ Videos block hidden - no videos found');
    console.log('videos_value:', {{ videos_value | json }});
  </script>
{% endif %}

<style>
  .video-title {
    font-family: 'Gotham' !important;
    font-weight: 700 !important;
  }
</style>