{% liquid
  # Use Shopify Discovery metafield for related products
  # Try different ways to access the metafield
  assign rel = product.metafields['shopify--discovery--product_recommendation']['related_products']
  if rel == blank
    assign rel = product.metafields.shopify__discovery__product_recommendation.related_products
  endif
  
  assign sets_metafield_key = block.settings.sets_metafield_key
  assign sets_key_parts = sets_metafield_key | split: '.'
  assign sets_ns = sets_key_parts.first
  assign sets_k = sets_key_parts.last
  assign sets_rel = product.metafields[sets_ns][sets_k]
  
  assign has_pair = false
  assign has_sets = false
  if rel and rel.value.size > 0
    assign has_pair = true
  endif
  if sets_rel and sets_rel.value.size > 0
    assign has_sets = true
  endif
%}

{% if has_pair or has_sets %}
<div class="tw-mt-[24px] tw-w-full md:tw-max-w-[75%]" {{ block.shopify_attributes }}>
<div class="tw-relative tw-flex tw-items-center tw-gap-[16px] tw-pb-[8px] tw-mb-[12px]" id="lwya-pair-tabs" role="tablist" aria-label="Related products tabs">
  <button type="button" class="tw-text-[15px] tw-font-gotham tw-font-700 tw-text-[#000000] tw-relative tw-z-10" data-tab="pair" role="tab" aria-selected="true" aria-controls="lwya-panel-pair">PAIR IT WITH</button>
  <button type="button" class="tw-text-[15px] tw-font-gotham tw-font-700 tw-text-[#9b9b9b] tw-relative tw-z-10" data-tab="sets" role="tab" aria-selected="false" aria-controls="lwya-panel-sets">SAVE WITH SETS</button>
  <div class="tw-flex-1"></div>
  <!-- Bottom border line - gray for inactive areas -->
  <div class="tw-absolute tw-bottom-0 tw-left-0 tw-w-full tw-h-[2px] tw-bg-[#e5e5e5]"></div>
  <!-- Active tab indicator - pink overlay for active tab area -->
  <div class="lwya-tab-indicator tw-absolute tw-bottom-0 tw-left-0 tw-h-[2px] tw-bg-[#d41870] tw-transition-all tw-duration-300 tw-ease-in-out tw-z-10" style="width: 0;"></div>
</div>

<div id="lwya-pair-content">
  <div data-panel="pair" id="lwya-panel-pair" role="tabpanel" aria-labelledby="lwya-panel-pair" aria-hidden="false">
    {% if rel and rel.value and rel.value.size > 0 %}
      <div class="tw-space-y-[20px]">
      {% for p in rel.value %} 
          {% comment %} List.product metafield contains product objects directly {% endcomment %}
          {% assign item = p %}
          {% if item and item.id %}
            <div class="tw-flex tw-gap-[40px] tw-items-start">
              <a href="{{ item.url }}" class="tw-block tw-overflow-hidden tw-bg-[#f6f6f6] tw-w-[100px] tw-h-[100px] md:tw-w-[160px] md:tw-h-[160px] tw-flex-shrink-0">
                {% if item.featured_image %}
                  <img src="{{ item.featured_image | image_url: width: 320 }}" alt="{{ item.title | escape }}" class="tw-w-full tw-h-full tw-object-cover" loading="lazy">
                {% endif %}
              </a>
              <div class="tw-flex-1 tw-flex tw-flex-col">
                <div>
                  <div class="tw-text-[14px] md:tw-text-[16px] tw-leading-[20px] tw-font-normal tw-text-[#000000] tw-mb-[8px] sm:tw-max-w-[50%] tw-mt-[4px]">{{ item.title }}</div>
                  <div class="tw-text-[16px] md:tw-text-[14px] tw-leading-[20px] tw-font-gotham tw-font-700 tw-text-[#d41870]">{{ item.price | money }}</div>
                </div>
                {% assign variant_count = item.variants.size %}
                {% if variant_count <= 1 %}
                  <form method="post" action="/cart/add" class="tw-mt-[16px] md:tw-mt-[20px]">
                    <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
                    <button type="submit" class="tw-flex tw-justify-center tw-items-center tw-w-full sm:tw-w-[152px] tw-h-[28px] tw-text-[12px] tw-leading-[16px] tw-font-medium tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-uppercase tw-py-[10px] tw-px-[20px] tw-transition-colors">ADD TO CART</button>
                  </form>
                {% else %}
                  {%- capture variant_images_json -%}
                    {
                      {%- for variant in item.variants -%}
                        "{{ variant.id }}": {% if variant.featured_media %}{{ variant.featured_media.preview_image.src | json }}{% elsif variant.featured_image %}{{ variant.featured_image.src | json }}{% elsif variant.image %}{{ variant.image.src | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    }
                  {%- endcapture -%}
                  <button type="button" class="lwya-pair-select-shade tw-mt-[16px] md:tw-mt-[20px] tw-w-full tw-flex tw-justify-center tw-items-center tw-w-full sm:tw-w-[152px] tw-h-[28px] tw-text-[12px] tw-leading-[16px] tw-font-medium tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-uppercase tw-py-[10px] tw-px-[20px] tw-transition-colors" data-product-id="{{ item.id }}" data-product-handle="{{ item.handle }}" data-variant-images='{{ variant_images_json | strip_newlines }}'>SELECT SHADE</button>
                 
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="tw-text-[13px] tw-text-[#888]">No related products configured.</div>
    {% endif %}
  </div>
  <div data-panel="sets" id="lwya-panel-sets" class="tw-hidden" role="tabpanel" aria-labelledby="lwya-panel-sets" aria-hidden="true">
    {% if sets_rel and sets_rel.value and sets_rel.value.size > 0 %}
      <div class="tw-space-y-[20px]">
        {% for p in sets_rel.value %}
          {% comment %} List.product metafield contains product objects directly {% endcomment %}
          {% assign item = p %}
          {% if item and item.id %}
            <div class="tw-flex tw-gap-[40px] tw-items-start">
              <a href="{{ item.url }}" class="tw-block tw-overflow-hidden tw-bg-[#f6f6f6] tw-w-[100px] tw-h-[100px] md:tw-w-[160px] md:tw-h-[160px] tw-flex-shrink-0">
                {% if item.featured_image %}
                  <img src="{{ item.featured_image | image_url: width: 320 }}" alt="{{ item.title | escape }}" class="tw-w-full tw-h-full tw-object-cover" loading="lazy">
                {% endif %}
              </a>
              <div class="tw-flex-1 tw-flex tw-flex-col">
                <div>
                  <div class="tw-text-[14px] md:tw-text-[16px] tw-leading-[20px] tw-font-normal tw-text-[#000000] tw-mb-[8px] sm:tw-max-w-[50%] tw-mt-[4px]">{{ item.title }}</div>
                  <div class="tw-text-[16px] md:tw-text-[14px] tw-leading-[20px] tw-font-bold tw-text-[#d41870]">{{ item.price | money }}</div>
                </div>
                {% assign variant_count = item.variants.size %}
                {% if variant_count <= 1 %}
                  <form method="post" action="/cart/add" class="tw-mt-[16px] md:tw-mt-[20px]">
                    <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
                    <button type="submit" class="tw-w-full sm:tw-w-[45%] tw-text-[12px] tw-leading-[16px] tw-font-medium tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-uppercase tw-py-[10px] tw-px-[20px] tw-transition-colors">ADD TO CART</button>
                  </form>
                {% else %}
                  {%- capture variant_images_json -%}
                    {
                      {%- for variant in item.variants -%}
                        "{{ variant.id }}": {% if variant.featured_media %}{{ variant.featured_media.preview_image.src | json }}{% elsif variant.featured_image %}{{ variant.featured_image.src | json }}{% elsif variant.image %}{{ variant.image.src | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    }
                  {%- endcapture -%}
                  <button type="button" class="lwya-pair-select-shade tw-mt-[16px] md:tw-mt-[20px] tw-w-full sm:tw-w-[45%] tw-text-[12px] tw-leading-[16px] tw-font-medium tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-uppercase tw-py-[10px] tw-px-[20px] tw-transition-colors" data-product-id="{{ item.id }}" data-product-handle="{{ item.handle }}" data-variant-images='{{ variant_images_json | strip_newlines }}'>SELECT SHADE</button>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="tw-text-[13px] tw-text-[#888]">No sets configured.</div>
    {% endif %}
  </div>
</div>
</div>

<!-- Variant Selection Modal -->
<div id="lwya-pair-variant-modal" class="lwya-pair-modal tw-fixed tw-inset-0 tw-z-[99999] tw-hidden tw-bg-black tw-bg-opacity-50" style="display: none; z-index: 999999 !important;">
  <div class="lwya-pair-modal-content tw-bg-white tw-max-w-[600px] tw-w-[90%] tw-max-h-[90vh] tw-overflow-y-auto tw-p-6 tw-relative tw-mx-auto" style="z-index: 1000000 !important;">
    <button type="button" class="lwya-pair-modal-close tw-absolute tw-top-4 tw-right-4 tw-text-gray-500 hover:tw-text-gray-700 tw-text-2xl tw-leading-none tw-w-8 tw-h-8 tw-flex tw-items-center tw-justify-center tw-cursor-pointer">&times;</button>
    
    <div class="lwya-pair-modal-product-info tw-mb-6">
      <h3 class="lwya-pair-modal-title tw-text-[20px] tw-font-bold tw-mb-2"></h3>
      <div class="lwya-pair-modal-price tw-text-[18px] tw-font-bold tw-text-[#d41870]"></div>
    </div>
    
    <div class="lwya-pair-modal-image tw-mb-6 tw-w-full tw-aspect-square tw-overflow-hidden tw-bg-[#f6f6f6]">
      <img src="" alt="" class="tw-w-full tw-h-full tw-object-cover" id="lwya-pair-modal-featured-image">
    </div>
    
    <div class="lwya-pair-modal-variants tw-mb-6"></div>
    <div class="lwya-pair-modal-selected-variant tw-mb-6 tw-text-[14px]">
      <span class="lwya-pair-modal-option-label tw-font-medium"></span>: <span class="lwya-pair-modal-option-value tw-font-normal"></span>
    </div>
    
    <form method="post" action="/cart/add" class="lwya-pair-modal-form">
      <input type="hidden" name="id" id="lwya-pair-modal-variant-id" value="">
      <button type="submit" class="tw-w-full tw-text-[14px] tw-leading-[18px] tw-font-medium tw-bg-[#d41870] hover:tw-bg-[#b91460] tw-text-white tw-uppercase tw-py-[12px] tw-px-[24px] tw-transition-colors">ADD TO CART</button>
    </form>
  </div>
</div>

<style>
.lwya-pair-modal {
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999 !important;
  position: fixed;
}
.lwya-pair-modal-content {
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  z-index: 1000000 !important;
  position: relative;
}
.lwya-pair-modal-variant-option {
  margin-bottom: 20px;
}
.lwya-pair-modal-variant-option label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 12px;
  color: #000;
  text-transform: uppercase;
}
.lwya-pair-modal-variant-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.lwya-pair-modal-variant-swatch {
  position: relative;
  cursor: pointer;
}
.lwya-pair-modal-variant-swatch input[type="radio"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.lwya-pair-modal-variant-swatch-label {
  display: block;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid transparent;
  transition: all 0.2s;
  cursor: pointer;
  background: content-box var(--swatch-background) no-repeat center / cover;
  padding: 2px;
}
.lwya-pair-modal-variant-swatch input[type="radio"]:checked + .lwya-pair-modal-variant-swatch-label {
  border-color: #d41870;
}
.lwya-pair-modal-variant-swatch-label:hover {
  border-color: #d41870;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('lwya-pair-variant-modal');
  if (!modal) return;
  
  const modalClose = modal.querySelector('.lwya-pair-modal-close');
  const selectShadeButtons = document.querySelectorAll('.lwya-pair-select-shade');
  const modalForm = modal.querySelector('.lwya-pair-modal-form');
  const variantIdInput = modal.querySelector('#lwya-pair-modal-variant-id');
  const featuredImage = modal.querySelector('#lwya-pair-modal-featured-image');
  const modalTitle = modal.querySelector('.lwya-pair-modal-title');
  const modalPrice = modal.querySelector('.lwya-pair-modal-price');
  const variantsContainer = modal.querySelector('.lwya-pair-modal-variants');
  
  let currentProductData = null;
  let currentSelectedVariant = null;
  
  // Get swatch config from settings
  const swatchConfigRaw = {{ settings.color_swatch_config | json }};
  const swatchConfig = {};
  if (swatchConfigRaw) {
    const lines = swatchConfigRaw.split('\n');
    lines.forEach(line => {
      const parts = line.split(':');
      if (parts.length >= 2) {
        const name = parts[0].trim().toLowerCase();
        const value = parts.slice(1).join(':').trim();
        swatchConfig[name] = value;
      }
    });
  }
  
  // Format money helper function
  function formatMoney(cents) {
    if (typeof cents === 'string') {
      cents = parseFloat(cents.replace('.', ''));
    }
    const dollars = (cents / 100).toFixed(2);
    return '$' + dollars;
  }
  
  // Get swatch style for a value
  function getSwatchStyle(value) {
    const downcaseValue = value.toLowerCase().trim();
    let swatchStyle = `linear-gradient(to right, ${downcaseValue}, ${downcaseValue})`;
    
    // Check swatch config
    if (swatchConfig[downcaseValue]) {
      const configValue = swatchConfig[downcaseValue];
      if (configValue.includes('#')) {
        swatchStyle = `linear-gradient(to right, ${configValue}, ${configValue})`;
      } else if (configValue.includes('linear-gradient(')) {
        swatchStyle = configValue;
      } else if (configValue.startsWith('http') || configValue.startsWith('/')) {
        swatchStyle = `url(${configValue})`;
      }
    }
    
    return swatchStyle;
  }
  
  // Close modal
  function closeModal() {
    modal.style.display = 'none';
    modal.classList.add('tw-hidden');
    document.body.style.overflow = '';
    
    // Restore header and height-observer visibility
    const header = document.querySelector('x-header, .header');
    if (header) {
      header.style.visibility = '';
      header.style.pointerEvents = '';
      header.style.opacity = '';
      header.style.zIndex = '';
    }
    const headerSection = document.querySelector('.shopify-section--header');
    if (headerSection) {
      headerSection.style.visibility = '';
      headerSection.style.pointerEvents = '';
      headerSection.style.opacity = '';
      headerSection.style.zIndex = '';
    }
    const heightObserver = document.querySelector('height-observer');
    if (heightObserver) {
      heightObserver.style.visibility = '';
      heightObserver.style.pointerEvents = '';
      heightObserver.style.opacity = '';
      heightObserver.style.zIndex = '';
    }
  }
  
  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  
  // Fetch product data and open modal
  selectShadeButtons.forEach(button => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const productHandle = button.getAttribute('data-product-handle');
      const variantImagesRaw = button.getAttribute('data-variant-images');
      
      if (!productHandle) {
        alert('Product handle not found');
        return;
      }
      
      // Parse variant images mapping from Liquid
      let variantImagesMap = {};
      if (variantImagesRaw) {
        try {
          variantImagesMap = JSON.parse(variantImagesRaw);
        } catch (e) {
          // Ignore parse errors
        }
      }
      
      try {
        const response = await fetch(`/products/${productHandle}.js`);
        if (!response.ok) {
          throw new Error(`Failed to fetch product: ${response.status}`);
        }
        const product = await response.json();
        
        if (!product || !product.variants || product.variants.length === 0) {
          alert('Product data invalid');
          return;
        }
        
        currentProductData = product;
        currentSelectedVariant = product.variants[0];
        
        // Store variant images map for this product
        product.variantImagesMap = variantImagesMap;
        
        // Update modal content
        modalTitle.textContent = product.title;
        modalPrice.textContent = formatMoney(currentSelectedVariant.price);
        
        // Update featured image - initial load
        let initialImageUrl = null;
        
        // Check variant images map from Liquid
        if (variantImagesMap && variantImagesMap[currentSelectedVariant.id]) {
          initialImageUrl = variantImagesMap[currentSelectedVariant.id];
        }
        // Check variant.featured_image
        else if (currentSelectedVariant.featured_image) {
          initialImageUrl = typeof currentSelectedVariant.featured_image === 'string' 
            ? currentSelectedVariant.featured_image 
            : (currentSelectedVariant.featured_image.src || currentSelectedVariant.featured_image);
        }
        // Fallback to first product image
        else if (product.images && product.images.length > 0) {
          const firstImage = product.images[0];
          initialImageUrl = typeof firstImage === 'string' ? firstImage : (firstImage.src || firstImage);
        }
        // Fallback to product featured image
        if (!initialImageUrl && product.featured_image) {
          initialImageUrl = product.featured_image;
        }
        
        if (initialImageUrl) {
          // Ensure URL is absolute
          if (initialImageUrl.startsWith('//')) {
            initialImageUrl = 'https:' + initialImageUrl;
          } else if (initialImageUrl.startsWith('/')) {
            initialImageUrl = window.location.origin + initialImageUrl;
          }
          featuredImage.src = initialImageUrl;
          featuredImage.alt = currentSelectedVariant.title || product.title;
        }
        
        // Build variant selectors as swatches
        variantsContainer.innerHTML = '';
        const selectedVariantLabel = modal.querySelector('.lwya-pair-modal-option-label');
        const selectedVariantValue = modal.querySelector('.lwya-pair-modal-option-value');
        
        if (product.options && product.options.length > 0) {
          product.options.forEach((optionName, optionIndex) => {
            const optionDiv = document.createElement('div');
            optionDiv.className = 'lwya-pair-modal-variant-option';
            
            // Fix: optionName might be an object, get the name property or use as string
            const optionNameStr = typeof optionName === 'object' && optionName.name 
              ? optionName.name 
              : (typeof optionName === 'string' ? optionName : 'Variant');
            
            const label = document.createElement('label');
            label.textContent = optionNameStr;
            optionDiv.appendChild(label);
            
            // Update selected variant display
            if (optionIndex === 0) {
              selectedVariantLabel.textContent = optionNameStr;
              selectedVariantValue.textContent = currentSelectedVariant.options[optionIndex] || '';
            }
            
            const swatchesContainer = document.createElement('div');
            swatchesContainer.className = 'lwya-pair-modal-variant-swatches';
            
            // Get unique values for this option
            const optionValues = [...new Set(product.variants.map(v => v.options[optionIndex]))];
            optionValues.forEach(value => {
              const swatchDiv = document.createElement('div');
              swatchDiv.className = 'lwya-pair-modal-variant-swatch';
              
              const radio = document.createElement('input');
              radio.type = 'radio';
              radio.name = `option-${optionIndex}`;
              radio.value = value;
              radio.id = `option-${optionIndex}-${value.replace(/\s+/g, '-').toLowerCase()}`;
              radio.setAttribute('data-option-index', optionIndex);
              radio.className = 'peer tw-sr-only';
              if (currentSelectedVariant.options[optionIndex] === value) {
                radio.checked = true;
              }
              
              // Create color swatch
              const swatchLabel = document.createElement('label');
              swatchLabel.className = 'lwya-pair-modal-variant-swatch-label';
              swatchLabel.setAttribute('for', radio.id);
              swatchLabel.setAttribute('title', value);
              
              // Get swatch style from config
              const swatchStyle = getSwatchStyle(value);
              swatchLabel.style.setProperty('--swatch-background', swatchStyle);
              
              radio.addEventListener('change', () => updateVariantSelection(product));
              
              swatchDiv.appendChild(radio);
              swatchDiv.appendChild(swatchLabel);
              swatchesContainer.appendChild(swatchDiv);
            });
            
            optionDiv.appendChild(swatchesContainer);
            variantsContainer.appendChild(optionDiv);
          });
        }
        
        // Set initial variant ID
        variantIdInput.value = currentSelectedVariant.id;
        
        // Show modal
        modal.style.display = 'flex';
        modal.classList.remove('tw-hidden');
        modal.style.alignItems = 'center';
        modal.style.justifyContent = 'center';
        document.body.style.overflow = 'hidden';
        
        // Hide header and height-observer when modal opens
        const header = document.querySelector('x-header, .header');
        if (header) {
          header.style.setProperty('visibility', 'hidden', 'important');
          header.style.setProperty('pointer-events', 'none', 'important');
          header.style.setProperty('opacity', '0', 'important');
          header.style.setProperty('z-index', '-1', 'important');
        }
        const headerSection = document.querySelector('.shopify-section--header');
        if (headerSection) {
          headerSection.style.setProperty('visibility', 'hidden', 'important');
          headerSection.style.setProperty('pointer-events', 'none', 'important');
          headerSection.style.setProperty('opacity', '0', 'important');
          headerSection.style.setProperty('z-index', '-1', 'important');
        }
        const heightObserver = document.querySelector('height-observer');
        if (heightObserver) {
          heightObserver.style.setProperty('visibility', 'hidden', 'important');
          heightObserver.style.setProperty('pointer-events', 'none', 'important');
          heightObserver.style.setProperty('opacity', '0', 'important');
          heightObserver.style.setProperty('z-index', '-1', 'important');
        }
      } catch (error) {
        console.error('Error loading product:', error);
      }
    });
  });
  
  // Update variant selection
  function updateVariantSelection(product) {
    const radios = variantsContainer.querySelectorAll('input[type="radio"]:checked');
    const selectedOptions = Array.from(radios).map(radio => radio.value);
    
    const matchedVariant = product.variants.find(v => {
      return v.options.length === selectedOptions.length &&
             v.options.every((opt, idx) => String(opt) === String(selectedOptions[idx]));
    });
    
    if (matchedVariant) {
      currentSelectedVariant = matchedVariant;
      variantIdInput.value = matchedVariant.id;
      modalPrice.textContent = formatMoney(matchedVariant.price);
      
      // Update selected variant display
      const selectedVariantLabel = modal.querySelector('.lwya-pair-modal-option-label');
      const selectedVariantValue = modal.querySelector('.lwya-pair-modal-option-value');
      if (product.options && product.options.length > 0) {
        const optionName = typeof product.options[0] === 'object' && product.options[0].name 
          ? product.options[0].name 
          : (typeof product.options[0] === 'string' ? product.options[0] : 'Variant');
        selectedVariantLabel.textContent = optionName;
        selectedVariantValue.textContent = selectedOptions[0] || '';
      }
      
      // Update featured image
      let imageUrl = null;
      
      // Check variant.featured_image from API
      if (matchedVariant.featured_image && matchedVariant.featured_image !== null) {
        imageUrl = typeof matchedVariant.featured_image === 'object' 
          ? matchedVariant.featured_image.src 
          : matchedVariant.featured_image;
      }
      
      // Check variant images map from Liquid
      if (!imageUrl && product.variantImagesMap) {
        const variantIdStr = String(matchedVariant.id);
        const variantIdNum = Number(matchedVariant.id);
        
        const imageFromMap = product.variantImagesMap[variantIdStr] || product.variantImagesMap[variantIdNum];
        if (imageFromMap && imageFromMap !== null && imageFromMap !== 'null') {
          imageUrl = imageFromMap;
        }
      }
      
      // Check featured_media from variant
      if (!imageUrl && matchedVariant.featured_media && matchedVariant.featured_media.preview_image) {
        imageUrl = matchedVariant.featured_media.preview_image.src;
      }
      
      // Fallback to first product image
      if (!imageUrl && product.images && product.images.length > 0) {
        const firstImage = product.images[0];
        imageUrl = typeof firstImage === 'string' ? firstImage : (firstImage.src || firstImage);
      }
      
      // Fallback to product featured image
      if (!imageUrl && product.featured_image) {
        imageUrl = product.featured_image;
      }
      
      // Update image with transition
      if (imageUrl) {
        // Ensure URL is absolute
        if (imageUrl.startsWith('//')) {
          imageUrl = 'https:' + imageUrl;
        } else if (imageUrl.startsWith('/')) {
          imageUrl = window.location.origin + imageUrl;
        }
        
        // Smooth transition when changing image
        featuredImage.style.transition = 'opacity 0.2s ease-in-out';
        featuredImage.style.opacity = '0';
        
        setTimeout(() => {
          featuredImage.src = imageUrl;
          featuredImage.alt = matchedVariant.title || product.title;
          
          // Wait for image to load before fading in
          if (featuredImage.complete) {
            featuredImage.style.opacity = '1';
          } else {
            featuredImage.onload = () => {
              featuredImage.style.opacity = '1';
            };
          }
        }, 200);
      }
    }
  }
  
  // Handle form submission
  modalForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(modalForm);
    
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      });
      
      if (response.ok) {
        closeModal();
        document.dispatchEvent(new CustomEvent('cart:updated'));
      } else {
        const error = await response.json();
        console.error('Error adding to cart:', error);
        alert('Failed to add product to cart. Please try again.');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Failed to add product to cart. Please try again.');
    }
  });
});
</script>
{% endif %}