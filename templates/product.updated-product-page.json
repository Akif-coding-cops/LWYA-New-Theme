    "featured_text_pEBz9q": {
      "type": "Featured-text",
      "settings": {
        "line": "Yes, we’re striving for perfection!",
        "image_text": "shopify://shop_images/Frame_2087324888.png",
        "line3": "",
        "line2": "This is your go-to daily concealer. Gone in a Swipe Center Core Concealer does it all. It’s magic for all ages, but it’s especially good for mature skin. Even without color correction, you’re going to be amazed at how well it covers and matches your skin. It’s truly revolutionary."
