    "about_us_belief_1": {
      "type": "about-us-belief",
      "name": "Our Belief",
      "settings": {
        "heading": "Our Belief",
        "body_text": "<p><strong>LWYA, Love Who You Are</strong>, was built on a simple but radical idea: <strong>beauty should make you feel more like yourself, not less.</strong></p><p>We are a beauty and lifestyle brand founded by Kim Gravel, and <strong>everything we make starts with the same question, does this actually work for real women?</strong> Not models. Not curated skin. Real women, with real lives, in real lighting.</p><p>Women who are raising families, building careers, showing up every single day, and sometimes just trying to get out the door looking like they have it together.</p>",
        "heading_color": "#d41870",
        "text_color": "#000000",
        "background_color": "#ffffff",
        "heading_size": 64,
        "heading_size_mobile": 36,
